#!/usr/bin/env bash
# abcd-outbound: v1
# abcd outbound gate, commit-message half — scaffolded by
# `abcd ahoy install --outbound-hook` into this repo's committed hooks, because
# this repository asked for it. abcd never installs it by default.
#
# Refuses a commit whose message carries a LIVE AGENT-SESSION URL or a tool's own
# attribution footer. Either one, once committed and pushed, comes out of public
# history only by rewriting it. The judgement is `abcd lint outbound`, never a
# pattern in this file: the session-URL detector is a pattern plus a classifier a
# shell copy could not match.
#
# HOW IT FINDS abcd. One way only — an absolute path this clone's own git config
# names, which a person sets once per clone:
#
#     git config --local abcd.binary /absolute/path/to/abcd
#
# Never a PATH search (a repository can shadow PATH), never an environment
# variable (a repo-scoped direnv could set one), and never a file this working
# tree carries (a pull could replace it): a setting that resolves into the
# working tree is not run.
#
# FAILS OPEN. When no usable abcd is configured, or the one configured cannot
# judge the message, this hook prints ONE warning line and the commit proceeds:
# refusing every commit wherever abcd is absent would change how this repository
# works, which is not abcd's to change. A message the binary judges and refuses
# is BLOCKED.
#
# Point this repo's hooks at the directory holding this file, once per clone:
#
#     git config core.hooksPath .githooks
#
# REACH: git runs this hook for `git commit` and for a `git merge` that creates a
# commit. `--no-verify`, `git rebase`, `git cherry-pick` and `git am` bypass it.
# A message that itself spells git's scissors line, followed by a `diff --git `
# line, is judged only above the scissors, even in a commit that keeps the text
# below it: a verbose commit and the scissors cleanup are chosen as often by a
# `-v` or `--cleanup` on the command line as by configuration, and a hook sees
# only the configuration, so it cannot tell a forged cut from git's own.
unset -f set 2>/dev/null || true
set -euo pipefail
# --- environment pin: the FIRST statements, before anything is read or run -------
# The same pin as the sibling name guard (.githooks/pre-commit): an inherited
# xtrace, a shell function shadowing a command, or an inherited IFS must not
# decide what this hook judges or runs.
case $- in *x*) set +x ;; esac
unset -f git mktemp rm printf cat command read echo exit test [ cd pwd trap readlink \
  declare continue break return local export set true 2>/dev/null || true
IFS=$' \t\n'
LC_ALL=C
export LC_ALL
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
# --- end environment pin --------------------------------------------------------

# skip prints the one warning line a fail-open branch gives, and lets the commit
# through.
skip() {
  printf 'commit-msg: abcd outbound check SKIPPED — %s; the commit proceeds unchecked\n' "$1" >&2
  exit 0
}

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  skip "git passed no message file to judge"
fi

bin=$(git config --local --get abcd.binary 2>/dev/null || true)
if [ -z "$bin" ]; then
  skip "no abcd binary is configured for this clone (set one: git config --local abcd.binary /absolute/path/to/abcd)"
fi
# The configured path is not printed: a directory name on it can be a private name.
case "$bin" in
  /*) ;;
  *) skip "abcd.binary is not an absolute path (set one: git config --local abcd.binary /absolute/path/to/abcd)" ;;
esac
if [ ! -f "$bin" ] || [ ! -x "$bin" ]; then
  skip "abcd.binary does not name an executable file (set one: git config --local abcd.binary /absolute/path/to/abcd)"
fi

# Resolve the setting to the file it finally names, following each symlink, so a
# link outside the tree that points into it is judged by where it lands.
real="$bin"
hops=0
while [ -L "$real" ]; do
  hops=$((hops + 1))
  if [ "$hops" -gt 40 ]; then
    skip "abcd.binary is a symlink chain that does not end"
  fi
  next=$(readlink "$real" 2>/dev/null || true)
  if [ -z "$next" ]; then
    skip "abcd.binary is a symlink that cannot be read"
  fi
  case "$next" in
    /*) real="$next" ;;
    *) real="${real%/*}/$next" ;;
  esac
done
real_dir=$(cd "${real%/*}" 2>/dev/null && pwd -P) || skip "abcd.binary's directory cannot be resolved"
top=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$top" ]; then
  top_real=$(cd "$top" 2>/dev/null && pwd -P) || top_real="$top"
  case "$real_dir/" in
    "$top_real"/*) skip "abcd.binary resolves to a file inside this working tree, which this hook never runs" ;;
  esac
fi

# The text git will record. git discards what follows its scissors line only for a
# verbose commit (the staged diff below the line) or the scissors cleanup mode, so
# the cut is made only at git's exact scissors line, prefixed with this clone's
# comment character, and only when a `diff --git` line follows it. Everywhere else
# the whole file is judged: an over-judged comment only ever refuses more.
comment="#"
while IFS= read -r line || [[ -n $line ]]; do
  [[ -n $line ]] && comment="${line#* }"
done <<<"$(git config --get-regexp '^core\.comment(char|string)$' 2>/dev/null || true)"
auto_candidates='#;@!$%^&|:'
cut_line=" ------------------------ >8 ------------------------"
is_scissors() {
  if [[ $comment == auto ]]; then
    [[ ${#1} -gt 1 && $auto_candidates == *"${1:0:1}"* && ${1:1} == "$cut_line" ]]
  else
    [[ $1 == "$comment$cut_line" ]]
  fi
}
lines=()
while IFS= read -r line || [[ -n $line ]]; do
  lines+=("$line")
done <"$msg_file"
n=${#lines[@]}
keep=$n
first=-1
for ((i = 0; i < n && first < 0; i++)); do
  if is_scissors "${lines[i]}"; then
    first=$i
  fi
done
if ((first >= 0)); then
  for ((j = first + 1; j < n && keep == n; j++)); do
    if [[ ${lines[j]} == "diff --git "* ]]; then
      keep=$first
    fi
  done
fi
message=""
for ((i = 0; i < keep; i++)); do
  message+="${lines[i]}"$'\n'
done
# An empty message is git's to refuse; nothing in it could leak.
if ! [[ $message =~ [^[:space:]] ]]; then
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/abcd-commit-msg.XXXXXX")" || skip "no temporary directory to judge the message in"
trap 'rm -rf "$work" || true' EXIT INT TERM HUP
artefact="$work/message"
printf '%s' "$message" >"$artefact"

root="${top:-$PWD}"
rc=0
out="$(cd "$root" && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX &&
  "$bin" lint outbound --label "commit message" --root "$root" "$artefact" 2>&1)" || rc=$?

# abcd exits 1 for more than a refusal (a stop it raises before any verb runs,
# an error it gives no code of its own, a binary too old to know `lint
# outbound`), so an exit 1 is a refusal only when the output carries the verb's
# own verdict line. Anything else is a check that never ran.
verdict="abcd lint outbound — ✗ commit message breaks the outbound policy"
refused=0
if [ "$rc" -eq 1 ]; then
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == "$verdict" ]]; then
      refused=1
    fi
  done <<<"$out"
  if [ "$refused" -eq 0 ]; then
    skip "the configured abcd exited 1 without judging the message, so it could not judge it"
  fi
fi

case "$rc" in
  0)
    ;;
  1)
    echo "commit-msg: BLOCKED — the commit message breaks the outbound policy." >&2
    while IFS= read -r line || [[ -n $line ]]; do
      printf '            %s\n' "$line" >&2
    done <<<"$out"
    echo "            delete the line named above and commit again." >&2
    exit 1
    ;;
  *)
    skip "the configured abcd could not judge the message (exit $rc)"
    ;;
esac
exit 0
