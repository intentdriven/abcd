name: <% if .Gate %>abcd-release-gate<% else %>release<% end %>
<% if .Abcd %>
# Releases are made by auto-release from main: a merge that rolls a new dated
# CHANGELOG version calls this workflow, which first re-runs the deterministic,
# Linux-only verify gate (gofmt, build, vet, the race leg, and the
# record/docs/reviews gates — a subset of the merge gate, which is the
# authority; see the release-gate runbook for what gates the merge alone)
# against the commit being released; only if that gate is green does it tag
# that commit, cross-compile the four binaries FROM THAT SAME COMMIT, generate a
# checksums.txt manifest over them, and create the GitHub Release with the
# binaries + checksums.txt attached (plus their SLSA build-provenance
# attestations once the repo is public — attestation is not offered on a
# user-owned private repo, so it is skipped there and re-enables automatically
# on the public flip): detect -> verify -> tag -> build -> publish.
# Nothing is pushed to any branch. Every job checks out a resolved commit SHA,
# fixed for the whole run — never the tag NAME (which could be re-pointed
# between jobs to swap unverified code into the build) and never a moved-on
# default-branch tip — so the binaries, checksums, and reported version all
# come from the released commit.
#
# Pushing a version tag (vX.Y.Z) still starts a run, and that run releases
# nothing: release provenance is verified against this workflow on main and
# the released commit, which only auto-release's call provides, so its first
# job (`pushed-tag`) refuses it before anything is checked out, built or
# signed, and every other job is skipped.
<%- else if .Gate %>
# abcd's release gate for this repository. It is CALLED — by auto-release.yml, or
# by this repository's own release workflow before its build step — and never
# triggered by a tag push of its own, so it cannot race a tag-driven workflow the
# repository already runs. It re-runs the verification gate against the commit
# being released; only if that gate is green does it make the tag (when asked),
# run the build job below and publish a GitHub Release from that same commit. A
# caller that builds and publishes itself passes `publish: false`, and the gate
# then verifies and tags only. Nothing is pushed to any branch, and the whole
# path runs on the built-in GITHUB_TOKEN. Every job checks out a resolved commit
# SHA, never a re-resolvable tag NAME. A manual workflow_dispatch runs the
# rehearsal (below), which arms the gate against a simulated release and
# publishes nothing.
<%- else if .RefusesPushedTag %>
# Releases are made by auto-release from <% .DefaultBranch %>: a merge that rolls a new
# dated CHANGELOG version calls this workflow, which re-runs the full
# verification gate against the commit being released; only if that gate is
# green does it tag that commit and build and publish a GitHub Release from it.
# Nothing is pushed to any branch, and the whole path runs on the built-in
# GITHUB_TOKEN. Every job checks out a resolved commit SHA, never the
# re-resolvable tag NAME and never a moved-on default-branch tip. A manual
# workflow_dispatch runs the rehearsal (below), which arms the gate against a
# simulated release and publishes nothing.
#
# Pushing a version tag (vX.Y.Z) still starts a run, and that run releases
# nothing: release provenance is verified against this workflow on
# <% .DefaultBranch %> and the released commit, which only auto-release's call
# provides, so its first job (`pushed-tag`) refuses it before anything is
# checked out, built or signed, and every other job is skipped.
<%- else %>
# Pushing a version tag (vX.Y.Z) re-runs the full verification gate against the
# PUSHED COMMIT; only if that gate is green does it build and publish a GitHub
# Release from that same commit. Nothing is pushed to any branch, and the whole
# path runs on the built-in GITHUB_TOKEN. Every job checks out `github.sha` — the
# commit the pushed tag pointed at — never the re-resolvable tag NAME and never the
# default-branch tip. Called by auto-release with create_tag, the same run makes
# the tag itself, and only once verify is green. A manual workflow_dispatch runs
# the rehearsal (below), which arms the gate against a simulated release and
# publishes nothing.
<%- end %>
on:
<%- if not .Gate %>
  push:
    tags:
      - 'v*'
<%- end %>
  # Called by auto-release.yml to release the newest dated CHANGELOG version
  # (adr-37). `tag` and `ref` are an unenforced caller CONTRACT — --verify-tag
  # checks only that the tag exists, not that it points at `ref`; the sole
  # caller (auto-release) binds them: ref = `git rev-parse "$tag^{commit}"` on
  # the re-release path, empty (-> github.sha, the commit verify gates and the
  # tag job then tags) on the fresh-tag path. A resolved commit SHA, never a tag
  # name, keeps the anti-tag-move property. `create_tag` is true on the
  # fresh-tag path only: the tag job below makes the tag after verify passes, so
  # a refused gate consumes no version (iss-2608231226347380).
  workflow_call:
    inputs:
      tag:
        required: true
        type: string
      ref:
        required: false
        type: string
        default: ''
      create_tag:
        required: false
        type: boolean
        default: false
<%- if .Gate %>
      # False when the caller builds and publishes the release itself: the gate
      # then verifies (and, with create_tag, tags) and its build and release
      # jobs are skipped.
      publish:
        required: false
        type: boolean
        default: true
<%- end %>
  # Manual rehearsal. A workflow_dispatch runs the `rehearsal` job below alongside
  # `verify`, and nothing that publishes: the publish job (`release`) is gated off
  # this event, and the rehearsal arms the gate's resolution path against a
  # simulated changelog roll and reviewed-content commit, proves the deterministic
  # gates admit it, and creates no tag, Release, or attestation. Run it green
  # once before the first real release (see
  # the release-gate runbook) — it closes the private->public activation gap that
  # otherwise surfaces only when the gate first meets a real tag.
  workflow_dispatch:

# The released tag name. workflow_call: inputs.tag (the tag auto-release just
# made). push-tag: inputs is empty, so this falls through to github.ref_name
# (the vX.Y.Z ref that triggered the run). Only the NAME — no job ever checks
# out this name; both check out the immutable commit SHA below.
env:
  TAG: ${{ inputs.tag || github.ref_name }}

# Never run two releases of the same tag concurrently, and never cancel a release
# mid-flight — a half-published release is worse than a queued one.
concurrency:
  group: <% if .Gate %>abcd-release-gate<% else %>release<% end %>-${{ inputs.tag || github.ref_name }}
  cancel-in-progress: false

# Floor for the workflow: read-only. The tag job elevates itself to contents:
# write only to push one new tag ref, the release job only to create the Release
# and upload its assets; verify stays read-only. No job pushes to any branch.
permissions:
  contents: read

jobs:
<%- if .RefusesPushedTag %>
  # A run started by a pushed version tag releases nothing: release provenance
  # is verified against this workflow on <% .DefaultBranch %> and the released commit, which
  # only auto-release's call provides. This job refuses such a run, naming the
  # path that does release, and verify (with every job after it) is skipped.
  # It checks out nothing and holds no write scope. The trigger stays, so a
  # pushed tag reads as a refused run rather than as no run at all. A call
  # from auto-release carries its caller's push event, but on a branch.
  pushed-tag:
    if: github.event_name == 'push' && github.ref_type == 'tag'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    steps:
      - name: Refuse a release started by a pushed tag
        # TAG arrives through the workflow env (injection-safe).
        run: |
          set -euo pipefail
          echo "::error::a pushed tag does not release; releases are made by auto-release from <% .DefaultBranch %>."
          printf "refusing to release '%s' from a pushed tag: auto-release tags and releases the newest dated CHANGELOG version once it merges to <% .DefaultBranch %>\n" "$TAG" >&2
          exit 1
<%- end %>
<%- if .Abcd %>

  # Gate the release on the pushed commit: the deterministic, Linux-only re-run
  # of the build and record gates (gofmt, build, vet, test, the race leg, the
  # record/docs drift gates, the reviews-charter discipline, smoke) — a subset
  # of ci.yml's merge gate, not a substitute for it. A red step here aborts
  # before anything is built
  # or published. Checked out at github.sha — the commit the pushed tag pointed at,
  # never the default-branch tip or the re-resolvable tag name — so the gate
  # exercises exactly the commit whose binaries will ship.
<%- else %>
<%- if .RefusesPushedTag %>
<% end %>
  # Gate the release on the pushed commit: the deterministic verification gate
<%- if .GoModule %>
  # (gofmt, build, vet, test, the race leg). A red step here aborts before anything
  # is built or published.
<%- else %>
  # (the steps below; this repository is not a Go module, so it runs no Go leg).
  # A red step here aborts before anything is built or published.
<%- end %> Checked out at github.sha — the commit the pushed tag
  # pointed at, never the default-branch tip or the re-resolvable tag name — so the
  # gate exercises exactly the commit that will ship.
  #
  # The MERGE gate is this repository's own pull-request CI: merging the release
  # roll is the release decision, so these checks decide whether it lands at all.
  # Require them on <% .DefaultBranch %> (derived from its workflows when this file
  # was scaffolded; the release-gate runbook lists them with the how-to):
<%- range .CIChecks %>
  #   - <% . %>
<%- else %>
  #   (none found: no pull-request CI workflow existed; see the runbook)
<%- end %>
<%- end %>
  verify:
<%- if .RefusesPushedTag %>
    # Skipped on a pushed tag's run, which the pushed-tag job refuses.
    if: github.event_name != 'push' || github.ref_type != 'tag'
<%- end %>
<%- if .Abcd %>
    # The race step's own -timeout (20m, sized in ci.yml) must fire before this
    # does, or a hang reads as a cancelled job with no goroutine dump: 20m for
    # the slowest package plus about 10m this job spends before it starts.
    timeout-minutes: 35
<%- else %>
    timeout-minutes: 15
<%- end %>
    runs-on: ubuntu-latest
    permissions:
      contents: read
<%- if .SemanticGates %>
    # The reviewed content commit the semantic gate below admitted, handed to
    # the release job so it signs the receipts of exactly the commit that was
    # gated rather than re-deriving it (iss-2608291814573570). Empty when the
    # gate step is skipped (private repo, rehearsal), where nothing reads it.
    outputs:
      content_sha: ${{ steps.receipts.outputs.content_sha }}
<%- end %>
    steps:
      - name: Check out the pushed commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # github.sha, not the tag ref: checkout re-resolves a NAMED ref at each
          # job's start, so a tag moved after the push could differ here. The sha is
          # the commit the pushed tag pointed at, immutable for this run. On the
          # workflow_call path, inputs.ref (a resolved commit SHA) overrides for
          # the re-release-from-tag case; empty inputs.ref falls through to
          # github.sha = the caller's HEAD = the commit auto-release just tagged.
          ref: ${{ inputs.ref || github.sha }}
<%- if .Abcd %>
          # Full history: the reviews-charter check (RD002, append-only) inspects
          # committed history for post-creation edits, which a shallow checkout misses.
<%- else %>
          # Full history so any gate that inspects committed history stays accurate.
<%- end %>
          fetch-depth: 0
          persist-credentials: false
<%- if .GoModule %>

      - name: Set up Go
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          # The toolchain go.mod declares, read from the declaration itself. A literal
          # beside it is a second spelling to bump, and the one that gets forgotten
          # leaves a job compiling on a toolchain the format gate would reject.
          go-version-file: go.mod
          # cache: false — this workflow is tag-triggered; module caching in a
          # release-triggering workflow is a cache-poisoning vector (zizmor).
          cache: false

      - name: Format (gofmt)
<%- if .Abcd %>
        # One definition of the gate, INVOKED rather than restated: the Makefile
        # target resolves gofmt from the toolchain go.mod declares, so the release
        # lane, the merge lane and the developer's pre-push run are one gate judged
        # by one binary (.abcd/development/principles/one-canonical-primitive.md).
        run: make fmt-check
<%- else %>
        # The gofmt inside the GOROOT this module's own toolchain resolves to, never
        # whichever one PATH offers. gofmt's rules move between releases, so a runner
        # whose preinstalled Go is newer than the go directive names files unformatted
        # that the declared toolchain calls correct — and "fixing" those files produces
        # a tree the declared toolchain then rejects in the other direction, with
        # nothing in the output saying which gofmt judged it. `go env GOROOT` follows
        # the go directive exactly as `go build` does, so the formatter and the
        # compiler in this job are the same toolchain by construction.
        run: |
          set -euo pipefail
          goroot="$(go env GOROOT)"
          unformatted="$("$goroot/bin/gofmt" -l .)"
          if [ -n "$unformatted" ]; then
            echo "gofmt: these files are not formatted; rewrite them with the same binary:" >&2
            echo "gofmt:   $goroot/bin/gofmt -w ." >&2
            echo "$unformatted" >&2
            exit 1
          fi
<%- end %>

      - name: Build
        run: go build ./...

      - name: Vet
        run: go vet ./...

      - name: Test
        run: go test ./...
<%- if .Abcd %>

      - name: Test (race, internal)
        run: go test -race -timeout 20m ./internal/surface/cli ./internal/core/reading ./internal/core/launch ./internal/core/lifeboat ./internal/core/lint ./internal/adapter/scanner ./internal/core/capture ./internal/core/ahoy ./internal/core/site ./internal/...
<%- else %>

      # A generic module may have no internal tree, so the race leg runs over the
      # whole module; a package-scoped pattern would fail every run with a
      # "no such file or directory" and wedge the release.
      - name: Test (race)
        run: go test -race ./...
<%- end %>
<%- end %>
<%- range .ExtraGates %>

      - name: <% .Name %>
        run: <% .Run %>
<%- end %>
<%- if .Abcd %>

      # --- The pinned plugin archive (adr-2609231048308186; ruling E1) --------
      # The ship committed the release's plugin archive — its download address
      # and SHA-256 — into .claude-plugin/marketplace.json, and every install or
      # update follows that pin; the harness refuses a download whose digest
      # differs. Re-render the archive from THIS commit, reproducibly, and refuse
      # the release unless it yields exactly the pinned digest: a pin the release
      # could not reproduce would name a zip nobody can publish, and every install
      # would fail. Refusing here, in verify, builds and publishes nothing, and on
      # the auto-release path it makes no tag either: the tag job needs verify,
      # so the version stays free. Skipped on the rehearsal path: a workflow_dispatch has
      # no release tag to bind (TAG is the branch name), and main between releases
      # pins the LAST release's archive, which its own tree no longer reproduces.
      # TAG reaches the script through the workflow env (injection-safe).
      - name: Plugin archive reproduces the committed pin (fail-closed)
        if: github.event_name != 'workflow_dispatch'
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/plugin-archive"
          mkdir -p "$out"
          go run ./cmd/abcd launch archive --out "$out" --tag "${TAG}" --verify --repository "${GITHUB_REPOSITORY}"
<%- end %>
<%- if .SemanticGates %>

      # --- The release tag names the released version (iss-2609251945586202) ---
      # The receipts gate below binds the receipts to the version the released
      # tree's CHANGELOG names, not to the tag, so the release tag must be
      # exactly "v" plus that version, read by record-lint's strict reader, the
      # one the receipts are bound with; this step compares the two and reads
      # no heading itself. A tag naming another version (v0.9.1 on a tree whose
      # newest dated heading is 0.9.0, or a v0.9.0-rc.1) is refused before the
      # receipts gate and before the tag job, so nothing is built, tagged or
      # published. Skipped on the rehearsal path,
      # where TAG is the branch name. TAG reaches the script through the
      # workflow env (injection-safe).
      - name: The release tag names the released CHANGELOG version (fail-closed)
        if: github.event_name != 'workflow_dispatch'
        run: |
          set -euo pipefail
          released="$(go run ./cmd/record-lint --released-version)"
          test -n "$released"   # never compare against an empty version (fail closed)
          if [ "$TAG" != "v$released" ]; then
            printf "refusing to release '%s': the released tree's CHANGELOG names %s, so its release tag is v%s\n" "$TAG" "$released" "$released" >&2
            exit 1
          fi
          echo "release tag $TAG names the released version $released"

      # --- Semantic release gate, armed BEFORE the tag (adr-52, Alternative 1) ---
      # The semantic gate (the LLM passes CI cannot run) refuses HERE, in verify,
      # alongside the deterministic gates — not in the `release` publish job below.
      # verify gates the release before it is built or published, so a semantic
      # refusal blocks the release the way a deterministic failure already does,
      # WITHOUT consuming a version — the fix for iss-2608231226347380, where a
      # gate that sat in the publish job wedged the immutable tag. On the
      # auto-release path the tag job below needs verify, so the tag itself is made
      # only after this gate and the deterministic ones above have passed.
      #
      # Skipped on the rehearsal path: verify runs on workflow_dispatch too, where
      # no real receipts exist, and a missing receipt there is not a refusal
      # (rehearsal is not a real release — the `rehearsal` job proves the arming
      # separately). Dormant on a private repo, exactly like the attestation in the
      # publish job; it activates on the public flip.
      #
      # The content commit is derived from the RECEIPTS DIRECTORY of the released
      # tree, not HEAD^2^/HEAD^ ancestry: a batched merge-queue push makes
      # github.sha the batch tip, so HEAD^2^ can resolve an unrelated PR's commit
      # (iss-355). record-lint --derive-content-sha reads
      # .abcd/work/reviews/<sha>/, which names the content commit and rides in the
      # released tree regardless of batch position, and fails closed on a wrong or
      # absent directory. No ${{ }} interpolation in the script (injection-safe).
      # The admitted sha is exported as the job's content_sha output, written
      # only after the gate passes, for the release job's provenance steps.
      - name: Semantic-gate receipts (fail-closed, before tag)
        id: receipts
        if: ${{ !github.event.repository.private && github.event_name != 'workflow_dispatch' }}
        run: |
          set -euo pipefail
          content="$(go run ./cmd/record-lint --derive-content-sha)"
          test -n "$content"   # never arm-nothing on an empty sha (fail closed)
          echo "reviewed content commit: $content"
          go run ./cmd/record-lint --release-gate "$content"<% range .SemanticGates %> \
            --require-gate <% . %><% end %>
          echo "content_sha=$content" >> "$GITHUB_OUTPUT"
<%- end %>

  # Create and push the annotated tag with the GITHUB_TOKEN — AFTER verify, so a
  # refused gate leaves no tag and the version stays free (iss-2608231226347380;
  # adr-52 moved the gate into verify, this moves the tag behind it). Runs only
  # when the caller asks (auto-release, fresh-tag path): a tag push already has
  # its tag, and the rehearsal makes none. This is the ONLY push the release
  # chain makes, and it targets a NEW tag ref only — never a branch. A
  # GITHUB_TOKEN-pushed tag raises no tag-push event, so nothing re-triggers.
  tag:
    needs: verify
    if: inputs.create_tag
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: write        # push the new tag ref
    steps:
      - name: Check out the verified commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # The commit verify checked out and gated, resolved the same way.
          ref: ${{ inputs.ref || github.sha }}
          # persist-credentials: true is REQUIRED here so `git push` below
          # authenticates as the GITHUB_TOKEN. Scoped to this single tag-creating
          # job whose only step pushes one new tag ref; no other step runs, so
          # the persisted credential is never exposed to untrusted input.
          persist-credentials: true

      - name: Create and push the annotated tag at the verified commit
        # Values arrive via env (no ${{ }} inside the script): injection-safe.
        env:
          COMMIT: ${{ inputs.ref || github.sha }}
        run: |
          set -euo pipefail
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          # Annotated tag at the commit verify passed and the release job below
          # checks out and ships.
          git tag -a "$TAG" -m "abcd $TAG" "$COMMIT"
          git push origin "refs/tags/$TAG"
<% if not .Abcd %>
  # The build, EMPTY BY DESIGN (iss-2608270559310755): abcd lays the gate
  # plumbing and does not guess how this repository builds. Fill the step below,
  # or replace this job's steps with a call to your own build, and leave every
  # file the release should carry in dist/: the release job downloads dist/ and
  # attaches each file in it to the GitHub Release. Left empty, the Release
  # carries its generated notes alone. It runs from the commit verify gated,
  # once the tag is in place, and never on the rehearsal.
  build:
    needs: [verify, tag]
    if: github.event_name != 'workflow_dispatch' && !cancelled() && needs.verify.result == 'success' && (needs.tag.result == 'success' || needs.tag.result == 'skipped')<% if .Gate %> && inputs.publish<% end %>
    timeout-minutes: 30
    runs-on: ubuntu-latest
    permissions:
      contents: read
    outputs:
      assets: ${{ steps.assets.outputs.assets }}
    steps:
      - name: Check out the verified commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # The commit verify gated, resolved exactly as verify resolved it.
          ref: ${{ inputs.ref || github.sha }}
          persist-credentials: false

      - name: Build the release assets into dist/
        # This repository's build goes here. TAG, the release tag, is in the
        # environment; write every asset the release should carry into dist/.
        run: mkdir -p dist

      - name: Count the release assets in dist/
        id: assets
        run: |
          set -euo pipefail
          if [ -n "$(ls -A dist 2>/dev/null)" ]; then
            echo "assets=true" >> "$GITHUB_OUTPUT"
          else
            echo "assets=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Hand dist/ to the release job
        if: steps.assets.outputs.assets == 'true'
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: release-assets
          path: dist/
          if-no-files-found: error
          retention-days: 1

  # Publish ONLY after verify is green and the build job succeeded, from the same
  # commit verify gated, so the published assets match the code that passed —
  # even if the tag were re-pointed since.
  release:
    needs: [verify, tag, build]
<%- else %>
  # Build and publish ONLY after verify is green. Binaries are cross-compiled from
  # the same pushed commit (github.sha) that verify just gated, so the shipped
  # artefacts match the code that passed — even if the tag were re-pointed since.
  release:
    needs: [verify, tag]
<%- end %>
    # The publish path never runs on a manual rehearsal (workflow_dispatch): that
    # event runs the `rehearsal` job, which publishes nothing. Otherwise it runs
    # once verify is green and the tag is in place — the tag job made it
    # (success) or the tag already existed and the job was skipped (a tag push,
    # or auto-release's heal path). !cancelled() is required because a skipped
    # need skips a job whose if uses no status function; it never fires on a
    # cancelled run, so a manual cancel cannot publish a half-finished state. A
    # FAILED tag job blocks the release, so a half-made tag never publishes.
<%- if .Abcd %>
    if: github.event_name != 'workflow_dispatch' && !cancelled() && needs.verify.result == 'success' && (needs.tag.result == 'success' || needs.tag.result == 'skipped')
<%- else %>
    if: github.event_name != 'workflow_dispatch' && !cancelled() && needs.verify.result == 'success' && (needs.tag.result == 'success' || needs.tag.result == 'skipped') && needs.build.result == 'success'<% if .Gate %> && inputs.publish<% end %>
<%- end %>
    timeout-minutes: 20
    runs-on: ubuntu-latest
<%- if .Abcd %>
    # A human stands between merge and publish: the environment carries a required
    # reviewer, so nothing ships until someone approves the pending deployment —
    # the server-side gate a merged PR cannot edit its way past.
    environment: release
<%- end %>
    permissions:
<%- if .Abcd %>
      contents: write       # create the Release and upload its assets (no branch push)
      id-token: write       # mint the OIDC token actions/attest signs with
      attestations: write   # publish the build-provenance attestations (public repo)
    outputs:
      # The numeric id of the draft Release this job creates. site.yml reads,
      # attaches to and publishes that Release by this id, never by its tag.
      release_id: ${{ steps.draft.outputs.id }}
<%- else %>
      contents: write       # create the Release (no branch push, no attestation)
<%- end %>
    steps:
      - name: Check out the pushed commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # github.sha (the commit the pushed tag pointed at), not the tag NAME and
          # not the default-branch tip, so the binaries below are built from the exact
          # commit verify gated. inputs.ref (resolved SHA) overrides on the
          # workflow_call re-release path, exactly as in verify.
          ref: ${{ inputs.ref || github.sha }}
<%- if .Abcd %>
          # Full history, the same checkout shape verify gated, so every step
          # here reads the repository the gate judged.
<%- else %>
          # Full history, so any history-walking gate has the commits it needs.
<%- end %>
          fetch-depth: 0
          persist-credentials: false

      - name: Refuse a tag that is not a vX.Y.Z release tag
        # TAG is inputs.tag or github.ref_name, and every later step consumes it:
        # the build stamps it into a quoted -ldflags recipe, where a double quote
        # in a legal v* ref would close the quoting and splice a command
        # (iss-2608261041218890). Refuse anything that is not a release tag
        # before it reaches any of them — the pattern site.yml applies to the
        # same value. A bash [[ =~ ]] match, deliberately NOT grep: grep is
        # line-oriented, so a tag carrying an embedded newline would pass on its
        # first line; [[ =~ ]] matches the whole string. TAG arrives through the
        # workflow env (injection-safe).
<%- if .Abcd %>
        #
        # A pre-release tag (vX.Y.Z-…) is refused too: this chain publishes a
        # Release only once site.yml has attached site.tar.gz, and site.yml
        # renders and publishes full releases only, so a pre-release would stay
        # an unpublished draft. Build metadata (vX.Y.Z+…) is not a pre-release.
<%- end %>
        run: |
          set -euo pipefail
          tag_re='^v[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$'
          if [[ ! $TAG =~ $tag_re ]]; then
            printf "refusing to release '%s': not a vX.Y.Z release tag\n" "$TAG" >&2
            exit 1
          fi
<%- if .Abcd %>
          pre_re='^v[0-9]+\.[0-9]+\.[0-9]+-'
          if [[ $TAG =~ $pre_re ]]; then
            printf "refusing to release '%s': a pre-release tag; this release chain publishes full vX.Y.Z releases only\n" "$TAG" >&2
            exit 1
          fi
<%- end %>
          echo "release tag: $TAG"

      - name: Refuse a tag already released; clear an unfinished draft of it
        # The Release is created as a DRAFT and published only once every asset
<%- if .Abcd %>
        # is attached (site.yml publishes it once it has attached site.tar.gz),
<%- else %>
        # is attached,
<%- end %>
        # so a run that stopped in between leaves a draft behind. A re-run, or
        # auto-release's heal path, clears that draft here and creates the
        # Release afresh from this run's own assets; the tag is never touched. A
        # tag whose Release is already PUBLISHED is refused: a published release
        # is never rebuilt. It runs straight after the tag shape-check, before
        # anything is built or signed, so a refused tag mints no attestation.
        # Each draft is chosen from the release listing by its tag and its draft
        # state, and deleted by the id the listing reports for it, never looked
        # up by tag name: a lookup by name can resolve a published Release of
        # the tag. A listing that fails refuses rather than guess. TAG arrives
        # through the workflow env (injection-safe).
        run: |
          set -euo pipefail
          id_re='^[0-9]+$'
          for _ in 1 2 3 4 5; do
            if ! rows="$(gh api "repos/${GITHUB_REPOSITORY}/releases?per_page=100" --paginate \
                --jq '.[] | [.id, .draft, .tag_name] | @tsv')"; then
              printf "refusing to release '%s': cannot list the repository's releases\n" "$TAG" >&2
              exit 1
            fi
            drafts=()
            while IFS=$'\t' read -r id draft tag; do
              [ "$tag" = "$TAG" ] || continue
              if [ "$draft" != true ]; then
                printf "refusing to release '%s': its Release is already published\n" "$TAG" >&2
                exit 1
              fi
              if [[ ! $id =~ $id_re ]]; then
                printf "refusing to release '%s': a draft of it carries no numeric id\n" "$TAG" >&2
                exit 1
              fi
              drafts+=("$id")
            done <<< "$rows"
            if [ "${#drafts[@]}" -eq 0 ]; then
              exit 0
            fi
            for id in "${drafts[@]}"; do
              echo "clearing unfinished draft Release ${id} of ${TAG}"
              gh api --method DELETE "repos/${GITHUB_REPOSITORY}/releases/${id}"
            done
          done
          printf "refusing to release '%s': its unfinished drafts did not clear\n" "$TAG" >&2
          exit 1
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Record the default-branch tip (no-branch-commit tripwire)
        # This release job must push NOTHING to any branch. Record the remote
        # default-branch tip now; the closing step re-reads it and fails the run if
        # the branch moved because of this job. Read the ref through the API with
        # GH_TOKEN: an anonymous `git ls-remote` cannot authenticate to a private repo,
        # and checkout ran with persist-credentials: false.
        run: |
          set -euo pipefail
          sha="$(gh api "repos/${GITHUB_REPOSITORY}/git/ref/heads/${DEFAULT_BRANCH}" --jq '.object.sha')"
          test -n "$sha"
          echo "DEFAULT_BRANCH_START_SHA=$sha" >> "$GITHUB_ENV"
          echo "default-branch tip at job start: $sha"
        env:
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
<%- if .GoModule %>

      - name: Set up Go
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          # The toolchain go.mod declares, read from the declaration itself. A literal
          # beside it is a second spelling to bump, and the one that gets forgotten
          # leaves a job compiling on a toolchain the format gate would reject.
          go-version-file: go.mod
          cache: false
<%- end %>
<%- if .SemanticGates %>

      # --- Semantic-gate provenance (iss-35; dormant until the public flip) ------
      # The gate that can REFUSE the release now runs in `verify`, before the tag
      # (adr-52). What remains here is provenance: take the reviewed content
      # commit verify gated and SIGN its receipts for an auditable release
      # attestation. By the
      # time this job runs, verify has already proved the receipts exist and are
      # PROMOTE, so these steps record what passed rather than deciding it. Gated on
      # repo visibility exactly like the binary attestation below — dormant on a
      # private repo, active on the public flip. Signing is provenance/tamper-
      # evidence, not committer-forgery-proof (a forged committed receipt would be
      # signed too); that residual is bounded by the identity gate + branch
      # protection.
      - name: Receive the reviewed content commit verify gated (the receipt subject)
        if: ${{ !github.event.repository.private }}
        # The sha verify's semantic gate admitted, received as its job output
        # rather than re-derived here: one derivation, so the receipts signed
        # below are those of the commit the gate judged (iss-2608291814573570).
        # verify checked out the same commit this job did (inputs.ref on the
        # re-release heal path, else github.sha). The value is shape-checked
        # before it reaches $GITHUB_ENV, a file path and the signed predicate —
        # [[ =~ ]], not grep, so an embedded newline cannot forge a second env
        # line — and an empty value fails closed. It arrives through env
        # (injection-safe).
        env:
          CONTENT_SHA_FROM_VERIFY: ${{ needs.verify.outputs.content_sha }}
        run: |
          set -euo pipefail
          sha_re='^[0-9a-f]{40}([0-9a-f]{24})?$'
          if [[ ! $CONTENT_SHA_FROM_VERIFY =~ $sha_re ]]; then
            echo "refusing: verify handed no well-formed content sha (got '${CONTENT_SHA_FROM_VERIFY}')" >&2
            exit 1
          fi
          echo "CONTENT_SHA=$CONTENT_SHA_FROM_VERIFY" >> "$GITHUB_ENV"
          echo "reviewed content commit: $CONTENT_SHA_FROM_VERIFY"

      - name: Attest the semantic-gate receipts (signed release provenance)
        if: ${{ !github.event.repository.private }}
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        with:
          subject-path: .abcd/work/reviews/${{ env.CONTENT_SHA }}/*.json
          predicate-type: https://abcd.dev/attestations/semantic-release-gate/v1
          # Only the immutable resolved content sha — never github.ref_name (an
          # attacker-influenceable tag name would inject into this signed JSON).
          predicate: |
            {"commit": "${{ env.CONTENT_SHA }}", "verificationResult": "PROMOTE"}

      - name: Verify the semantic-gate receipt attestation
        if: ${{ !github.event.repository.private }}
        # CONTENT_SHA reaches this step via $GITHUB_ENV (receive step above).
        # The attestation is held to the release workflow on <% .DefaultBranch %>
        # (the exact certificate identity and source ref auto-release's call
        # signs with), a GitHub-hosted runner, and RELEASE_COMMIT, the commit
        # this run releases, as the source digest: the same policy every
        # consumer of the release's attestations verifies.
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          RELEASE_COMMIT: ${{ inputs.ref || github.sha }}
        run: |
          set -euo pipefail
          for r in .abcd/work/reviews/"$CONTENT_SHA"/*.json; do
            gh attestation verify "$r" \
              --repo "${GITHUB_REPOSITORY}" \
              --cert-identity "https://github.com/${GITHUB_REPOSITORY}/.github/workflows/<% .ReleaseWorkflow %>@refs/heads/<% .DefaultBranch %>" \
              --source-ref refs/heads/<% .DefaultBranch %> \
              --source-digest "${RELEASE_COMMIT}" \
              --deny-self-hosted-runners \
              --predicate-type https://abcd.dev/attestations/semantic-release-gate/v1
          done
<%- end %>
<% if .Abcd %>
      - name: Cross-compile the four binaries (version-stamped from the tag)
        # VERSION=<tag> stamps `abcd --version` via -ldflags -X …internal/core.Version.
        # The binaries built here are the ones checksummed, attested, and uploaded
        # below, so the manifest, the published assets, and the reported version are
        # all in sync.
        run: make build VERSION="${TAG}"

      - name: Assert every shipped binary carries a VCS stamp (iss-232)
        # The ahoy install staleness gate reads vcs.revision from BuildInfo; a
        # release built with -buildvcs=false or from a .git-less archive would
        # make `ahoy install` refuse for every pinned user. Abort the release
        # before anything is checksummed, attested, or published.
        run: ./scripts/check-vcs-stamp.sh

      - name: Render the plugin archive and prove it matches the committed pin
        # The plugin archive (abcd-plugin-<tag>.zip) is rendered HERE, from the
        # same commit as the binaries, and --verify refuses unless its digest is
        # the one the ship pinned in .claude-plugin/marketplace.json — the check
        # verify already made, repeated on the exact bytes that ship. It lands in
        # bin/ AFTER the VCS-stamp check (it is not a binary), so the abcd-* globs
        # below checksum, attest and upload it with the binaries. A refusal
        # removes the archive, so nothing unpinned can be published.
        # --repository proves that address is this repository's release, where
        # the step below uploads, before anything is published.
        run: go run ./cmd/abcd launch archive --out bin --tag "${TAG}" --verify --repository "${GITHUB_REPOSITORY}"

      - name: Generate checksums.txt over the four binaries and the plugin archive
        # Hash the exact binaries and the archive above into a sha256sum-format
        # manifest, uploaded as a release asset. No rebuild — the bytes hashed here
        # are the bytes uploaded below.
        run: |
          set -euo pipefail
          cd bin
          sha256sum abcd-* > checksums.txt
          cat checksums.txt

      - name: Attest build provenance for the binaries, the plugin archive and checksums.txt
        # Signed SLSA build-provenance over the exact files uploaded below. Runs
        # BEFORE the Release so a failed attestation aborts before publishing.
        # Skipped on a user-owned private repo (GitHub gates the feature by repo
        # visibility); the release still ships binaries + checksums.txt, and
        # attestation re-enables automatically on the public flip. A skipped step is
        # not a failure, so the publish steps still run.
        # actions/attest directly, with no predicate input: it then generates SLSA
        # build provenance itself, the predicate the actions/attest-build-provenance
        # wrapper produced by calling it (iss-273). NODE_OPTIONS is the wrapper's
        # own env on that call, kept so the attestation is made exactly as before.
        if: ${{ !github.event.repository.private }}
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        env:
          NODE_OPTIONS: "--max-http-header-size=32768"
        with:
          subject-path: |
            bin/abcd-*
            bin/checksums.txt

      - name: Create the draft GitHub Release with the binaries, the plugin archive and checksums.txt
        # --draft: the Release is created unpublished, with every asset this job
        # built attached. site.yml (the `site` job below) attaches site.tar.gz
        # and then publishes it, so the Release becomes visible only once all of
        # its assets are attached, and no asset is added to a published Release:
        # the flow GitHub recommends, and the one immutable releases require.
        # --verify-tag: refuse unless the tag already exists remotely —
        # existence only; it does not check what the tag points at (see the contract
        # note at the top of this file). --generate-notes lists the merged PRs since
        # the previous tag; CHANGELOG.md remains the durable, hand-curated record.
        # --notes is prepended to the generated notes: it states the harness floor
        # the archive-sourced plugin needs (ruling E3).
        #
        # THE WINDOW: the ship's merge to main already names this release's archive
        # in the catalog, and the archive is downloadable only once the Release is
        # published — after this job and the site render — later still while the
        # release environment's approval waits. An install or update
        # in between fails closed: the download 404s, the harness refuses, and an
        # installed plugin stays on its previous release. Nothing wrong can be
        # installed, because the pinned digest refuses any other bytes. The window
        # cannot be closed from this side (the pin must be in the tagged tree, so
        # it lands before the tag), so it is kept short: approve the release
        # deployment promptly once the ship merges.
        #
        # The draft's numeric id is read back straight after it is created: the
        # one Release carrying the tag must be this draft, and every later read
        # and write of it, here and in site.yml, names that id, never the tag.
        id: draft
        run: |
          set -euo pipefail
          gh release create "${TAG}" bin/abcd-* bin/checksums.txt --draft --verify-tag --title "${TAG}" --notes "${RELEASE_NOTES}" --generate-notes
          id_re='^[0-9]+$'
          rows="$(gh api "repos/${GITHUB_REPOSITORY}/releases?per_page=100" --paginate \
            --jq '.[] | [.id, .draft, .tag_name] | @tsv')"
          ours="$(awk -F '\t' -v tag="$TAG" '$3 == tag' <<<"$rows")"
          id="${ours%%$'\t'*}"
          if [[ ! $id =~ $id_re ]] || [ "$ours" != "${id}"$'\t'"true"$'\t'"${TAG}" ]; then
            printf "refusing to release '%s': the one Release carrying it must be the draft just created; the repository lists:\n%s\n" "$TAG" "$ours" >&2
            exit 1
          fi
          echo "id=$id" >> "$GITHUB_OUTPUT"
          echo "created draft Release ${id} of ${TAG}"
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          RELEASE_NOTES: "The plugin installs from this release's pinned archive and needs Claude Code v2.1.224 or later; the binaries have no harness requirement."

      - name: Verify the draft's attestation against a freshly downloaded binary
        # Pre-publication gate: prove the attestation is real and retrievable for
        # the bytes users will download. Download every asset FRESH from the
        # draft, by the draft's id and each asset's id (the job token can read a
        # draft; publishing changes no asset), require each to be byte-identical
        # to the file this job built and the draft to carry nothing else, and
        # verify the binary and the plugin archive against provenance signed by
        # this release workflow on
        # <% .DefaultBranch %>, on a GitHub-hosted runner, from RELEASE_COMMIT, the
        # commit this run releases — the policy every installer verifies. A
        # failure here leaves the Release an unpublished draft. Skipped on a
        # private repo (no attestation was produced above); re-enables alongside
        # attestation on the flip.
        if: ${{ !github.event.repository.private }}
        run: |
          set -euo pipefail
          DL="$RUNNER_TEMP/attest-verify"
          mkdir -p "$DL"
          id_re='^[0-9]+$'
          assets="$(gh api "repos/${GITHUB_REPOSITORY}/releases/${RELEASE_ID}/assets?per_page=100" --paginate \
            --jq '.[] | [.id, .name] | @tsv')"
          built=0
          for f in bin/abcd-* bin/checksums.txt; do
            name="${f##*/}"
            aid="$(awk -F '\t' -v n="$name" '$2 == n {print $1}' <<<"$assets")"
            if [[ ! $aid =~ $id_re ]]; then
              printf "the draft Release %s has no %s attached\n" "$RELEASE_ID" "$name" >&2
              exit 1
            fi
            gh api -H 'Accept: application/octet-stream' \
              "repos/${GITHUB_REPOSITORY}/releases/assets/${aid}" > "$DL/$name"
            cmp "$DL/$name" "$f"
            built=$((built + 1))
          done
          if [ "$(awk 'NF {n++} END {print n + 0}' <<<"$assets")" != "$built" ]; then
            printf "the draft Release %s carries an asset this job did not build:\n%s\n" "$RELEASE_ID" "$assets" >&2
            exit 1
          fi
          gh attestation verify "$DL/abcd-linux-amd64" \
            --repo "${GITHUB_REPOSITORY}" \
            --cert-identity "https://github.com/${GITHUB_REPOSITORY}/.github/workflows/<% .ReleaseWorkflow %>@refs/heads/<% .DefaultBranch %>" \
            --source-ref refs/heads/<% .DefaultBranch %> \
            --source-digest "${RELEASE_COMMIT}" \
            --deny-self-hosted-runners
          # The plugin archive too: fresh from the draft, attested by this
          # workflow, and byte-identical to the archive verified against the pin.
          gh attestation verify "$DL/abcd-plugin-${TAG}.zip" \
            --repo "${GITHUB_REPOSITORY}" \
            --cert-identity "https://github.com/${GITHUB_REPOSITORY}/.github/workflows/<% .ReleaseWorkflow %>@refs/heads/<% .DefaultBranch %>" \
            --source-ref refs/heads/<% .DefaultBranch %> \
            --source-digest "${RELEASE_COMMIT}" \
            --deny-self-hosted-runners
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          RELEASE_COMMIT: ${{ inputs.ref || github.sha }}
          RELEASE_ID: ${{ steps.draft.outputs.id }}
<%- else %>
      - name: Receive the build job's dist/
        if: needs.build.outputs.assets == 'true'
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-assets
          path: dist/

      - name: Create the GitHub Release as a draft, attach dist/, then publish it
        # The Release is created as a --draft with every asset attached and
        # published only after, so it never appears with an asset missing and no
        # asset is added to a published Release: the flow GitHub recommends, and
        # the one immutable releases require.
        # --verify-tag: refuse unless the tag already exists remotely —
        # existence only; it does not check what the tag points at (see the contract
        # note at the top of this file). Every file the build job left in dist/ is
        # attached; with none, the Release carries its notes alone. --generate-notes
        # lists the merged PRs since the previous tag; CHANGELOG.md remains the
        # durable record. GITHUB_TOKEN-only: no personal access token, no elevated
        # secret.
        #
        # The draft is then addressed by its numeric id alone, never by its tag:
        # the one Release carrying the tag must be this draft, its assets exactly
        # the files of dist/, each uploaded and with the digest of the file
        # attached. It is published by that id, marked latest only when no
        # published release carries a higher version, and its assets are read
        # again afterwards and must be the ones checked.
        run: |
          set -euo pipefail
          assets=()
          if [ -d dist ]; then
            while IFS= read -r -d '' f; do assets+=("$f"); done < <(find dist -type f -print0 | sort -z)
          fi
          id_re='^[0-9]+$'
          ver_re='^v([0-9]+)\.([0-9]+)\.([0-9]+)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$'
          if [[ ! $TAG =~ $ver_re ]]; then
            printf "refusing to publish '%s': not a vX.Y.Z release tag\n" "$TAG" >&2
            exit 1
          fi
          mine=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}")
          gh release create "${TAG}" ${assets[@]+"${assets[@]}"} --draft --verify-tag --title "${TAG}" --generate-notes

          # The one Release carrying the tag is the draft just created.
          rows="$(gh api "repos/${GITHUB_REPOSITORY}/releases?per_page=100" --paginate \
            --jq '.[] | [.id, .draft, .prerelease, .tag_name] | @tsv')"
          ours="$(awk -F '\t' -v tag="$TAG" '$4 == tag' <<<"$rows")"
          id="${ours%%$'\t'*}"
          if [[ ! $id =~ $id_re ]] || [ "$ours" != "${id}"$'\t'"true"$'\t'"false"$'\t'"${TAG}" ]; then
            printf "refusing to publish '%s': the one Release carrying it must be the draft just created; the repository lists:\n%s\n" "$TAG" "$ours" >&2
            exit 1
          fi

          # Its assets are exactly the files of dist/, uploaded, each with the
          # digest of the file attached.
          list_assets() {
            gh api "repos/${GITHUB_REPOSITORY}/releases/${id}/assets?per_page=100" --paginate \
              --jq '.[] | [.id, .name, .state, (.digest // "")] | @tsv' | sort
          }
          attached="$(list_assets)"
          bad=0
          count=0
          for f in ${assets[@]+"${assets[@]}"}; do
            count=$((count + 1))
            name="${f##*/}"
            want="sha256:$(sha256sum "$f" | awk '{print $1}')"
            if ! awk -F '\t' -v n="$name" -v d="$want" \
                '$2 == n && $3 == "uploaded" && ($4 == "" || $4 == d) {found = 1} END {exit !found}' <<<"$attached"; then
              printf "refusing to publish '%s': %s is not attached uploaded with the digest of dist/%s\n" "$TAG" "$name" "$name" >&2
              bad=1
            fi
          done
          if [ "$(awk 'NF {n++} END {print n + 0}' <<<"$attached")" != "$count" ]; then
            printf "refusing to publish '%s': the draft carries assets other than the files of dist/:\n%s\n" "$TAG" "$attached" >&2
            bad=1
          fi
          [ "$bad" = 0 ] || exit 1

          # Latest only when no published release carries a higher version, so a
          # re-released older tag does not become the latest.
          latest=true
          while IFS=$'\t' read -r _ draft pre tag; do
            [ "$draft" = false ] && [ "$pre" = false ] && [[ $tag =~ $ver_re ]] || continue
            higher=false
            for i in 1 2 3; do
              a=$((10#${BASH_REMATCH[i]}))
              b=$((10#${mine[i-1]}))
              if [ "$a" -ne "$b" ]; then
                [ "$a" -lt "$b" ] || higher=true
                break
              fi
              if [ "$i" = 3 ] && [ -n "${mine[3]}" ] && [ -z "${BASH_REMATCH[4]}" ]; then
                higher=true
              fi
            done
            if [ "$higher" = true ]; then
              echo "${tag} is a higher published version; ${TAG} is published without becoming the latest release."
              latest=false
              break
            fi
          done <<<"$rows"

          gh api -X PATCH "repos/${GITHUB_REPOSITORY}/releases/${id}" \
            -F draft=false -f make_latest="$latest" --jq '.draft' >/dev/null

          # The Release as published carries exactly the assets checked.
          after="$(list_assets)"
          if [ "$after" != "$attached" ]; then
            printf "'%s' assets changed after they were checked. Checked (id, name, state, digest):\n%s\nNow attached:\n%s\n" "$TAG" "$attached" "$after" >&2
            exit 1
          fi
          if [ "$(gh api "repos/${GITHUB_REPOSITORY}/releases/${id}" --jq '.draft')" != false ]; then
            printf "'%s' is still a draft after publishing it\n" "$TAG" >&2
            exit 1
          fi
          echo "published ${TAG} (Release ${id}, latest: ${latest})"
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
<%- end %>

      - name: Assert the release job pushed nothing to the default branch
        # Close the no-branch-commit tripwire opened at job start. Runs last so it
        # covers every preceding step. !cancelled(): the tripwire must still run when
        # an earlier step FAILED — an abnormal run is exactly when an unexpected push
        # most needs catching. If the tip is unchanged, done. If it moved, a push from
        # this job would land as github-actions[bot], so a bot commit in the moved
        # range fails the run, while an unrelated concurrent human merge is tolerated.
        if: ${{ !cancelled() }}
        run: |
          set -euo pipefail
          end="$(gh api "repos/${GITHUB_REPOSITORY}/git/ref/heads/${DEFAULT_BRANCH}" --jq '.object.sha')"
          if [ "$end" = "${DEFAULT_BRANCH_START_SHA}" ]; then
            echo "default branch unchanged across the release job (${end}); the job pushed nothing."
            exit 0
          fi
          committers="$(gh api "repos/${GITHUB_REPOSITORY}/compare/${DEFAULT_BRANCH_START_SHA}...${end}" \
            --jq '[.commits[].committer.login // "unknown"] | unique | join(" ")')"
          echo "default branch moved during the release job: ${DEFAULT_BRANCH_START_SHA} -> ${end} (committers: ${committers})"
          case " ${committers} " in
            *" github-actions[bot] "*)
              echo "a github-actions[bot] commit landed on the default branch during this job — the release workflow must never push to a branch" >&2
              exit 1
              ;;
          esac
          echo "movement attributed to commits outside this job; the release job itself pushed nothing."
        env:
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
<%- if .Abcd %>

  # Deploy abcdev.app for this tag (adr-48). Invoked here, from the release chain,
  # because GitHub fires no `release:` event for a Release created with the workflow's
  # own GITHUB_TOKEN — the same semantic auto-release.yml's header documents — so a
  # `release: published` trigger on site.yml would never fire for this repository's
  # releases. Running after `release` also removes the race against the asset uploads
  # the site workflow reads: `gh release create` has already returned.
  #
  # PUBLICATION happens here. The `release` job leaves the Release a DRAFT holding
  # the binaries, the plugin archive and checksums.txt and hands on its numeric id;
  # site.yml's render attaches site.tar.gz to that draft, and its `publish` job
  # checks every asset again and then publishes the Release, both by that id,
  # before its `deploy` job moves abcdev.app. So the Release becomes visible only
  # once every asset is attached, and no asset is added after publication — the
  # flow immutable releases require. A failed render therefore leaves the Release
  # an unpublished draft: re-run the failed jobs of this run, which renders,
  # attaches and publishes it. A failed deploy after `publish` leaves the Release
  # published and only the website behind.
  #
  # `needs: release` keeps a red site from changing a byte of what the release job
  # built, while `!cancelled()` keeps this job from inheriting a cancellation. A
  # called workflow's failure IS the caller's failure, so a red site turns this
  # whole run red.
  #
  # The job dependency isolates RUNTIME failures, and only those. The input contract
  # below is resolved at PARSE time: a `with:` block that does not match site.yml's
  # declared workflow_call inputs fails the whole run before any job starts, and no
  # `needs:` can contain that. So the contract is pinned by a test instead —
  # TestSiteWorkflowInputContract, in internal/core/site — and a drift fails CI on the
  # pull request rather than on release day.
  #
  # It runs only on a SUCCESSFUL release — a site for a
  # release that failed to publish would describe bytes nobody can download; on the
  # rehearsal path `release` is skipped, so this is skipped too and nothing deploys.
  # The called workflow is idempotent per tag, so re-running this job is safe.
  #
  # It sits BEFORE the rehearsal job, not at the end of the file: `rehearsal` must
  # stay the last job, because the AC6 property test slices it from its key to EOF
  # to prove it holds no publish verb. abcd-cli only — a managed repo scaffolded
  # from this template has no website and receives no site.yml.
  site:
    needs: release
    if: ${{ !cancelled() && needs.release.result == 'success' }}
    permissions:
      contents: write       # site.yml: attach site.tar.gz to the draft Release and publish it (no branch push)
      id-token: write       # site.yml: OIDC for the site.tar.gz build-provenance attestation
      attestations: write   # site.yml: publish that attestation (public repo)
    uses: ./.github/workflows/site.yml
    with:
      # The same expression the workflow-level TAG env uses: inputs.tag on the
      # workflow_call path, the pushed tag ref name on the tag-push path.
      tag: ${{ inputs.tag || github.ref_name }}
      # The draft Release the release job created, by its numeric id: site.yml
      # reads, attaches to and publishes that Release by this id alone.
      release_id: ${{ needs.release.outputs.release_id }}
      # Explicit, never defaulted: site.yml refuses any other value, so its production
      # path can only be reached by a caller that asked for it by name.
      mode: production
    # `inherit` rather than a named `secrets:` block because the named form cannot
    # work here: a job that calls a reusable workflow may not declare
    # `environment:`, so this caller can never resolve an environment secret in
    # order to pass one on. What inherit conveys is the caller's own set, and it
    # is what lets the callee's `environment:`-declaring jobs resolve their
    # environment secrets at all.
    #
    # This line is necessary and NOT sufficient on its own: the same line is
    # required at every level of the call chain, including auto-release.yml's
    # call to this workflow. It was missing there through v0.6.5, so
    # this whole chain ran with an empty secrets context and the production
    # deploy failed on a credential that had never been conveyed
    # (iss-2608231912566984). The environment WAS applied on that path — a
    # deployment record was created for each failed attempt — which is what made
    # the cause look like the environment rather than the context.
    #
    # Measured rather than reasoned, on a canary environment secret through the
    # same two-level shape: top-level job with the environment SET; nested twice
    # with no secrets line EMPTY; nested twice with inherit at the outer call SET.
    #
    # The blast radius is what inherit actually conveys, and this repository holds
    # NO repository-scoped and no organization secrets — every Cloudflare
    # credential is scoped to the `site` / `site-preview` environments, which the
    # callee's own jobs gate on.
    secrets: inherit # zizmor: ignore[secrets-inherit]
<%- end %>

  # The manual rehearsal (workflow_dispatch). It arms the full gate against a
  # SIMULATED changelog roll and reviewed-content commit — reproducing the
  # two-commit release-branch shape and the auto-release merge — proves the gate
  # resolves and admits, and PUBLISHES NOTHING: it holds contents: read only (so
  # it cannot create a tag, Release, or attestation even by mistake), pushes
  # nothing, and every mutation stays in the runner's throwaway checkout. A green
  # rehearsal is the runbook precondition for the first real release.
  rehearsal:
    if: github.event_name == 'workflow_dispatch'
    timeout-minutes: 15
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Check out (full history)
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # Full history so the content-commit resolution below can walk parents,
          # exactly as <% .ReleaseWorkflow %>'s semantic gate does.
          fetch-depth: 0
          persist-credentials: false
<%- if .GoModule %>

      - name: Set up Go
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          # The toolchain go.mod declares, read from the declaration itself. A literal
          # beside it is a second spelling to bump, and the one that gets forgotten
          # leaves a job compiling on a toolchain the format gate would reject.
          go-version-file: go.mod
          cache: false
<%- end %>
<%- if .SemanticGates %>

      - name: Simulate a changelog roll and a BATCHED merge-queue push
        # No ${{ }} interpolation (injection-safe): the script writes only the
        # runner's throwaway checkout and $GITHUB_ENV. Nothing here is pushed.
        # Reproduces the iss-355 hazard: the release roll is merged, then an
        # UNRELATED PR is merged on top in the same batch, so the released tip is
        # the unrelated merge and HEAD^2^ no longer points at the content commit.
        run: |
          set -euo pipefail
          git config user.name 'rehearsal[bot]'
          git config user.email 'rehearsal@localhost'
          base="$(git rev-parse --verify HEAD)"
          date="$(date -u +%Y-%m-%d)"
          # Content commit on a scratch branch: simulate rolling [Unreleased] into a
          # dated heading — the reviewed content commit a real release names.
          # The heading is a plain vX.Y.Z (0.0.0, below every real release): the
          # gate's reader refuses a newest heading it cannot parse, so a
          # pre-release spelling here would refuse the rehearsal.
          git switch -q -c rehearsal-sim
          if grep -q '^## \[Unreleased\]' CHANGELOG.md 2>/dev/null; then
            awk -v d="$date" '1; /^## \[Unreleased\]/ && !done {print ""; print "## [0.0.0] - " d; done=1}' CHANGELOG.md > CHANGELOG.rehearsal
            mv CHANGELOG.rehearsal CHANGELOG.md
          else
            printf '\n## [0.0.0] - %s\n' "$date" >> CHANGELOG.md
          fi
          git add -A
          git commit -q -m 'rehearsal: simulated changelog roll (content commit)'
          content="$(git rev-parse --verify HEAD)"
          # Receipts commit: names the content commit and sits one commit later —
          # the two-commit shape that keeps the receipt-vs-tag self-reference from
          # ever blocking the release.
          mkdir -p ".abcd/work/reviews/$content"
          printf '{"rehearsal":true,"content":"%s"}\n' "$content" > ".abcd/work/reviews/$content/rehearsal.json"
          git add -A
          git commit -q -m 'rehearsal: simulated receipts commit'
          # Merge the release into base, then merge an UNRELATED PR on top of it —
          # the batched-queue shape where github.sha is the batch tip, not the
          # release merge. HEAD^2^ of this tip resolves the unrelated PR's parent,
          # NOT the content commit; the receipts-directory derivation must still
          # find the content commit.
          git switch -q -c rehearsal-merge "$base"
          git merge -q --no-ff -m 'rehearsal: merge simulated release' rehearsal-sim
          git switch -q -c rehearsal-unrelated
          printf 'unrelated batch-mate\n' > .rehearsal-unrelated
          git add -A
          git commit -q -m 'rehearsal: unrelated batch-mate PR'
          git switch -q rehearsal-merge
          git merge -q --no-ff -m 'rehearsal: merge unrelated batch-mate' rehearsal-unrelated
          echo "REHEARSAL_CONTENT_SHA=$content" >> "$GITHUB_ENV"

      - name: Resolve the reviewed content commit (<% .ReleaseWorkflow %>'s derivation)
        # Mirrors <% .ReleaseWorkflow %>'s derivation exactly: the content commit is read from
        # the RECEIPTS DIRECTORY of the released tree, not HEAD^2^/HEAD^ ancestry.
        # Asserts it lands on the simulated content commit AND that the old HEAD^2^
        # derivation would NOT — the iss-355 regression the batched shape above
        # exercises.
        run: |
          set -euo pipefail
          content="$(go run ./cmd/record-lint --derive-content-sha)"
          test -n "$content"
          test "$content" = "${REHEARSAL_CONTENT_SHA}"
          old="$(git rev-parse --verify 'HEAD^2^')"
          if [ "$old" = "$content" ]; then
            echo "rehearsal: BUG — the batched simulation did not diverge HEAD^2^ from the content commit" >&2
            exit 1
          fi
          echo "rehearsal: the gate arms against content commit $content (present in the released tree); HEAD^2^ ($old) would have misresolved under batching"
<%- else %>

      - name: Simulate a changelog roll and the two-commit release branch
        # No ${{ }} interpolation (injection-safe): the script writes only the
        # runner's throwaway checkout and $GITHUB_ENV. Nothing here is pushed.
        run: |
          set -euo pipefail
          git config user.name 'rehearsal[bot]'
          git config user.email 'rehearsal@localhost'
          base="$(git rev-parse --verify HEAD)"
          date="$(date -u +%Y-%m-%d)"
          # Content commit on a scratch branch: simulate rolling [Unreleased] into a
          # dated heading — the reviewed content commit a real release names.
          # The heading is a plain vX.Y.Z (0.0.0, below every real release): the
          # gate's reader refuses a newest heading it cannot parse, so a
          # pre-release spelling here would refuse the rehearsal.
          git switch -q -c rehearsal-sim
          if grep -q '^## \[Unreleased\]' CHANGELOG.md 2>/dev/null; then
            awk -v d="$date" '1; /^## \[Unreleased\]/ && !done {print ""; print "## [0.0.0] - " d; done=1}' CHANGELOG.md > CHANGELOG.rehearsal
            mv CHANGELOG.rehearsal CHANGELOG.md
          else
            printf '\n## [0.0.0] - %s\n' "$date" >> CHANGELOG.md
          fi
          git add -A
          git commit -q -m 'rehearsal: simulated changelog roll (content commit)'
          content="$(git rev-parse --verify HEAD)"
          # Receipts commit: names the content commit and sits one commit later —
          # the two-commit shape that keeps the receipt-vs-tag self-reference from
          # ever blocking the release.
          mkdir -p ".abcd/work/reviews/$content"
          printf '{"rehearsal":true,"content":"%s"}\n' "$content" > ".abcd/work/reviews/$content/rehearsal.json"
          git add -A
          git commit -q -m 'rehearsal: simulated receipts commit'
          # Merge into the base, reproducing the auto-release merge whose second
          # parent is the receipts commit (so HEAD^2^ resolves the content commit).
          git switch -q -c rehearsal-merge "$base"
          git merge -q --no-ff -m 'rehearsal: merge simulated release' rehearsal-sim
          echo "REHEARSAL_CONTENT_SHA=$content" >> "$GITHUB_ENV"

      - name: Resolve the reviewed content commit (<% .ReleaseWorkflow %>'s derivation)
        # This profile arms no receipt gate, so <% .ReleaseWorkflow %> derives no content
        # commit. The step proves the two-commit release shape instead: HEAD^2^
        # of the merge (HEAD^ on a direct tag) lands on the simulated content
        # commit, an ancestor of the released commit, which is the commit the
        # receipts directory names once a semantic gate is configured.
        run: |
          set -euo pipefail
          released="$(git rev-parse --verify HEAD)"
          if git rev-parse -q --verify "HEAD^2" >/dev/null 2>&1; then
            content="$(git rev-parse --verify "HEAD^2^")"
          else
            content="$(git rev-parse --verify "HEAD^")"
          fi
          test -n "$content"
          git merge-base --is-ancestor "$content" "$released"
          test "$content" = "${REHEARSAL_CONTENT_SHA}"
          echo "rehearsal: the gate would arm against content commit $content (present in the released tree)"
<%- end %>
<%- if .Abcd %>

      - name: Arm the deterministic record gate against the simulated tree
        # The deterministic half of the gate must pass on the simulated roll. The
        # semantic half (record-lint --release-gate) activates with the real gate on
        # the public flip; here the resolution above proves it would arm correctly.
        run: go run ./cmd/record-lint
<%- end %>

      - name: Prove the gate admits and nothing was published
        run: |
          set -euo pipefail
<%- if .GoModule %>
          # Build the simulated tree — the deterministic leg the gate requires.
          go build ./...
<%- end %>
          echo "rehearsal: gate arming resolved; the deterministic gates admit the simulated roll."
          echo "rehearsal: nothing published — no tag, Release, or attestation was created (contents: read)."
