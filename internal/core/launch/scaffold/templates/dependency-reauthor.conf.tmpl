# Dependency-bump re-authoring: this repository's declaration
# (itd-2609221842494980). Its presence is the opt-in: `abcd launch scaffold`
# keeps the dependency-reauthor workflow current while this file exists, and
# never rewrites the file itself.
#
# THE OWNER. A bot's in-bound bump is re-authored with this person as author and
# committer. Setting it is that person's act: it is the one-time acceptance that
# a workflow asserts their authorship, with no person in the loop, for commits
# inside the bound below and no others. While either value is empty, an in-bound
# bump is refused rather than re-authored as anybody else.
owner_name=
owner_email=

# THE BOUND. One row per ecosystem and directory:
#   ecosystem=<bot login> <branch prefix> <directory> <file name> [<file name>...]
# <directory> is the one .github/dependabot.yml declares for the ecosystem (`/`
# for the root, `/docs`). A pull request is re-authored only when its author and
# the run's actor are the row's bot, its branch starts with the row's prefix, it
# carries one commit by that bot, and that commit only modifies files the row
# names, at the row's directory: a file added, deleted or renamed, or the same
# name in any other directory, is outside the bound. A bot or an ecosystem with
# no row is left alone. A workflow file is never a manifest: an Actions bump
# stays a person's to land.
# The accepted residual: the bound judges which files a bump changes, never what
# it writes in them, so a manifest's content inside the bound (a go.mod replace,
# toolchain or tool directive, a go.sum line) is re-authored unreviewed.
ecosystem=dependabot[bot] dependabot/go_modules/ / go.mod go.sum
ecosystem=dependabot[bot] dependabot/npm_and_yarn/ / package.json package-lock.json
ecosystem=dependabot[bot] dependabot/pip/ / requirements.txt pyproject.toml poetry.lock
ecosystem=dependabot[bot] dependabot/bundler/ / Gemfile Gemfile.lock
ecosystem=dependabot[bot] dependabot/cargo/ / Cargo.toml Cargo.lock
