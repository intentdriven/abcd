{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' hook prompt-router-reset"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|AskUserQuestion|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' guard hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' hook session-end"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' hook prompt-router-reset"
          },
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' hook session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' hook stop"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' hook stop-failure"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' hook subagent-stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/abcd/bin/abcd' hook prompt-router"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
