          "type": "bool"
        },
        {
          "name": "remote",
          "type": "bool"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy",
      "subcommands": [
        "connect",
        "credential",
        "doctor",
        "install",
        "remote",
        "shared-folder",
        "uninstall",
        "worktree"
      ]
    },
