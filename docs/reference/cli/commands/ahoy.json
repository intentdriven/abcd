{
  "format_version": 3,
  "commands": [
    {
      "path": "abcd ahoy",
      "sentence": "Detect abcd's install state and list its gaps, or report one mode a flag names: Writes nothing; refuses any argument or two modes at once.",
      "usage": "abcd ahoy [flags]",
      "flags": [
        {
          "name": "dry-run",
          "type": "bool"
        },
        {
          "name": "identity",
          "type": "bool"
        },
        {
          "name": "providers",
          "type": "bool"
        },
        {
          "name": "remote",
          "type": "bool"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy",
      "subcommands": [
        "connect",
        "credential",
        "doctor",
        "install",
        "remote",
        "shared-folder",
        "uninstall",
        "worktree"
      ],
      "next": [
        {
          "command": "abcd ahoy install",
          "when": "when it lists an install gap"
        },
        {
          "command": "abcd ahoy doctor",
          "when": "to see every gap, user-scope state included"
        }
      ]
    },
    {
      "path": "abcd ahoy connect",
      "sentence": "Verify a provider and configure it, or guide setup: Writes ~/.abcd.noindex/ and the key's home, nothing guided; refuses no --model off a terminal.",
      "usage": "abcd ahoy connect [<provider>] [flags]",
      "flags": [
        {
          "name": "answer",
          "type": "string"
        },
        {
          "name": "base-url",
          "type": "string"
        },
        {
          "name": "env",
          "type": "string"
        },
        {
          "name": "field",
          "type": "string"
        },
        {
          "name": "file",
          "type": "string"
        },
        {
          "name": "guide",
          "type": "bool"
        },
        {
          "name": "home",
          "type": "string",
          "allowed": [
            "external",
            "abcd",
            "keychain",
            "none"
          ]
        },
        {
          "name": "key",
          "type": "string"
        },
        {
          "name": "model",
          "type": "list"
        },
        {
          "name": "resume",
          "type": "string"
        },
        {
          "name": "stream-usage",
          "type": "bool",
          "default": "true"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy connect local --base-url http://127.0.0.1:8080/v1 --model example-model --home none",
      "next": [
        {
          "command": "abcd ahoy credential",
          "when": "to list the credentials abcd now reads"
        },
        {
          "command": "abcd ahoy doctor",
          "when": "to check nothing else is missing"
        }
      ]
    },
    {
      "path": "abcd ahoy credential",
      "sentence": "List the credentials abcd reads, explain one, or verify and store it: Writes the chosen home only with --home; refuses a value the adapter's call fails.",
      "usage": "abcd ahoy credential [<name>] [flags]",
      "flags": [
        {
          "name": "env",
          "type": "string"
        },
        {
          "name": "field",
          "type": "string"
        },
        {
          "name": "file",
          "type": "string"
        },
        {
          "name": "home",
          "type": "string",
          "allowed": [
            "external",
            "abcd",
            "keychain"
          ]
        }
      ],
      "inputs": [],
      "example": "abcd ahoy credential",
      "next": [
        {
          "command": "abcd ahoy connect <provider>",
          "when": "to configure the provider the credential is for"
        }
      ]
    },
    {
      "path": "abcd ahoy doctor",
      "sentence": "Report every install gap, user-scope state included: Writes nothing; refuses any argument.",
      "usage": "abcd ahoy doctor [flags]",
      "flags": [],
      "inputs": [],
      "example": "abcd ahoy doctor",
      "next": [
        {
          "command": "abcd ahoy install",
          "when": "when it reports a gap install can apply"
        }
      ]
    },
    {
      "path": "abcd ahoy install",
      "sentence": "Apply the install gaps the detection finds: Writes .abcd/, the name-guard hooks and the PATH entry, and installs a tool only on a yes; refuses a stale binary.",
      "usage": "abcd ahoy install [flags]",
      "flags": [
        {
          "name": "adopt",
          "type": "bool"
        },
        {
          "name": "allow-stale-binary",
          "type": "bool"
        },
        {
          "name": "answered-in",
          "type": "string",
          "default": "Terminal",
          "allowed": [
            "Terminal",
            "Claude Code"
          ]
        },
        {
          "name": "answers",
          "type": "string"
        },
        {
          "name": "attribution",
          "type": "bool"
        },
        {
          "name": "bin-dir",
          "type": "string"
        },
        {
          "name": "details",
          "type": "bool"
        },
        {
          "name": "dev",
          "type": "bool"
        },
        {
          "name": "docs-target",
          "type": "string",
          "allowed": [
            "agents_md",
            "skip"
          ]
        },
        {
          "name": "install-tool",
          "type": "list",
          "allowed": [
            "gitleaks"
          ],
          "each": "member"
        },
        {
          "name": "live-sessions",
          "type": "string",
          "allowed": [
            "local",
            "cloud",
            "both",
            "none"
          ]
        },
        {
          "name": "only-waiting",
          "type": "bool"
        },
        {
          "name": "oracle-backend",
          "type": "string",
          "allowed": [
            "host-delegated",
            "native",
            "cli",
            "api",
            "mcp"
          ]
        },
        {
          "name": "outbound",
          "type": "bool"
        },
        {
          "name": "readme-parts",
          "type": "string",
          "allowed": [
            "release-badge",
            "build-badge",
            "abcd-badge",
            "licence",
            "links",
            "contents",
            "none"
          ],
          "each": "member"
        },
        {
          "name": "refuse-adopt",
          "type": "bool"
        },
        {
          "name": "scan-deep",
          "type": "string",
          "allowed": [
            "true",
            "false"
          ]
        },
        {
          "name": "visibility",
          "type": "string",
          "allowed": [
            "private",
            "public"
          ]
        },
        {
          "name": "yes",
          "type": "bool"
        }
      ],
      "inputs": [
        {
          "flag": "answers",
          "kind": "answers",
          "name": "interview answers"
        }
      ],
      "example": "abcd ahoy install",
      "next": [
        {
          "command": "abcd ahoy doctor",
          "when": "to confirm no gap is left"
        },
        {
          "command": "abcd",
          "when": "to read the board of the repository just set up"
        }
      ]
    },
    {
      "path": "abcd ahoy remote",
      "sentence": "Apply abcd's GitHub settings baseline: Writes nothing bare, only the settings, rulesets and their mirrors through apply; refuses an unknown sub-verb.",
      "usage": "abcd ahoy remote [flags]",
      "flags": [],
      "inputs": [],
      "example": "abcd ahoy remote",
      "subcommands": [
        "apply"
      ],
      "next": [
        {
          "command": "abcd ahoy remote apply",
          "when": "when a GitHub setting differs from the baseline"
        }
      ]
    },
    {
      "path": "abcd ahoy remote apply",
      "sentence": "Apply every GitHub setting the remote audit finds differing: Writes those settings, abcd's own rulesets and their mirrors; refuses an unconfirmed run.",
      "usage": "abcd ahoy remote apply [flags]",
      "flags": [
        {
          "name": "yes",
          "type": "bool"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy remote apply",
      "next": [
        {
          "command": "abcd ahoy remote",
          "when": "to confirm no setting differs any more"
        }
      ]
    },
    {
      "path": "abcd ahoy shared-folder",
      "sentence": "Say what the shared folder is for, or choose it so a stop can cross accounts: Writes the choice given a folder; refuses no terminal or an unsafe folder.",
      "usage": "abcd ahoy shared-folder [<folder>] [--person <account>] [flags]",
      "flags": [
        {
          "name": "person",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy shared-folder /Users/Shared",
      "next": [
        {
          "command": "abcd implement stop",
          "when": "to stop the unattended runs of every account that chose the folder"
        }
      ]
    },
    {
      "path": "abcd ahoy uninstall",
      "sentence": "Remove abcd from this repository, leaving .abcd/ in place: Writes the removal of the marker block, PATH copy, and provenance record; refuses any argument.",
      "usage": "abcd ahoy uninstall [flags]",
      "flags": [
        {
          "name": "bin-dir",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy uninstall",
      "no_next": "abcd is gone from the repository, so no abcd command usually follows"
    },
    {
      "path": "abcd ahoy worktree",
      "sentence": "List this repository's worktrees and its lane in the worktree store: Writes nothing; refuses a store it cannot trust or a directory outside a checkout.",
      "usage": "abcd ahoy worktree [flags]",
      "flags": [],
      "inputs": [],
      "example": "abcd ahoy worktree",
      "subcommands": [
        "add",
        "list",
        "prune",
        "trim-cache"
      ],
      "next": [
        {
          "command": "abcd ahoy worktree add <name>",
          "when": "to start a second session's work in a worktree of its own"
        },
        {
          "command": "abcd ahoy worktree prune --dry-run",
          "when": "to see which merged, clean worktrees can be reclaimed"
        }
      ]
    },
    {
      "path": "abcd ahoy worktree add",
      "sentence": "Add a worktree in this repository's lane of the worktree store: Writes the worktree, its start record and its local tier; refuses a taken or reserved name.",
      "usage": "abcd ahoy worktree add <name> [flags]",
      "flags": [
        {
          "name": "branch",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy worktree add example-lane",
      "next": [
        {
          "command": "abcd reserve <record-id> --footprint <path>",
          "when": "before working a record in the new worktree"
        }
      ]
    },
    {
      "path": "abcd ahoy worktree list",
      "sentence": "List this repository's worktrees and its lane, or every lane with --all: Writes nothing; refuses a store it cannot trust, or outside a checkout without --all.",
      "usage": "abcd ahoy worktree list [flags]",
      "flags": [
        {
          "name": "all",
          "type": "bool"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy worktree list",
      "next": [
        {
          "command": "abcd ahoy worktree prune --dry-run",
          "when": "to see which merged, clean worktrees can be reclaimed"
        }
      ]
    },
    {
      "path": "abcd ahoy worktree prune",
      "sentence": "Reclaim this lane's merged, clean worktrees and trim the Go cache to its limit: Writes the notes archive and removes both; refuses a store it cannot trust.",
      "usage": "abcd ahoy worktree prune [flags]",
      "flags": [
        {
          "name": "dry-run",
          "type": "bool"
        },
        {
          "name": "yes",
          "type": "list"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy worktree prune --dry-run",
      "next": [
        {
          "command": "abcd ahoy worktree prune",
          "when": "after a --dry-run, to reclaim what it listed"
        },
        {
          "command": "abcd ahoy worktree list",
          "when": "to see the worktrees left"
        }
      ]
    },
    {
      "path": "abcd ahoy worktree trim-cache",
      "sentence": "Delete the Go build cache's oldest entries down to its size limit: Writes its answer for the next lane; refuses a cache it cannot prove is Go's.",
      "usage": "abcd ahoy worktree trim-cache [flags]",
      "flags": [
        {
          "name": "dry-run",
          "type": "bool"
        }
      ],
      "inputs": [],
      "example": "abcd ahoy worktree trim-cache --dry-run",
      "next": [
        {
          "command": "abcd ahoy worktree trim-cache",
          "when": "after a --dry-run, to delete what it listed"
        }
      ]
    }
  ]
}
