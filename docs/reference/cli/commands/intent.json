{
  "format_version": 1,
  "commands": [
    {
      "path": "abcd intent",
      "sentence": "File a draft intent from quoted text, or render the intent store's status bare: Writes the draft into drafts/; refuses a lone word.",
      "usage": "abcd intent [text] [flags]",
      "flags": [
        {
          "name": "impact",
          "type": "string"
        },
        {
          "name": "production-mode",
          "type": "string"
        },
        {
          "name": "title",
          "type": "string"
        }
      ],
      "inputs": [],
      "subcommands": [
        "audit",
        "condition",
        "consistency",
        "edge",
        "hold",
        "interview",
        "link",
        "plan",
        "prepass",
        "ready",
        "reclassify",
        "target",
        "unhold"
      ]
    },
    {
      "path": "abcd intent audit",
      "sentence": "List or drain owed fidelity reviews, emit an intent's request, or check issue drift: Writes an OWED stub only for --owed or an id; refuses an unshipped intent.",
      "usage": "abcd intent audit [<itd-N>] | audit --owed [--max <n>] | audit --issue-drift [--strict] [flags]",
      "flags": [
        {
          "name": "issue-drift",
          "type": "bool"
        },
        {
          "name": "max",
          "type": "int"
        },
        {
          "name": "owed",
          "type": "bool"
        },
        {
          "name": "route",
          "type": "list"
        },
        {
          "name": "strict",
          "type": "bool"
        }
      ],
      "inputs": [],
      "example": "abcd intent audit itd-2609010000000001",
      "subcommands": [
        "ingest"
      ]
    },
    {
      "path": "abcd intent audit ingest",
      "sentence": "Ingest an intent-audit verdict into the shipped intent: Writes its Audit Notes; refuses without --verdict-json.",
      "usage": "abcd intent audit ingest --verdict-json <path> [--dry-run] [flags]",
      "flags": [
        {
          "name": "dry-run",
          "type": "bool"
        },
        {
          "name": "route",
          "type": "list"
        },
        {
          "name": "verdict-json",
          "type": "string"
        }
      ],
      "inputs": [
        {
          "flag": "verdict-json",
          "kind": "json",
          "name": "intent audit verdict",
          "schema_version": 1,
          "version_in": "schema_version"
        }
      ],
      "example": "abcd intent audit ingest --verdict-json verdict.json"
    },
    {
      "path": "abcd intent condition",
      "sentence": "Read or disposition a shipped intent's scope conditions: Writes a dated condition block; refuses an unresolved occasion or thin grounds.",
      "usage": "abcd intent condition <itd-N> [<cond-id> --disposition <survived|narrowed|falsified|untested> --occasioned-by <rdi-N|itd-N> --grounds \"<why>\" [--narrowing \"<what now holds>\"]] [flags]",
      "flags": [
        {
          "name": "disposition",
          "type": "string"
        },
        {
          "name": "grounds",
          "type": "string"
        },
        {
          "name": "narrowing",
          "type": "string"
        },
        {
          "name": "occasioned-by",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd intent condition itd-2609010000000001"
    },
    {
      "path": "abcd intent consistency",
      "sentence": "Emit the consistency request over the brief and every intent, or one intent against them: Writes the request locally; refuses a superseded intent.",
      "usage": "abcd intent consistency [<itd-N>] [flags]",
      "flags": [
        {
          "name": "max-chunks",
          "type": "int",
          "default": "8"
        },
        {
          "name": "route",
          "type": "list"
        }
      ],
      "inputs": [],
      "subcommands": [
        "ingest"
      ]
    },
    {
      "path": "abcd intent consistency ingest",
      "sentence": "Ingest consistency findings as a dated review and a capture per finding: Writes the report and the ledger records; refuses without --findings-json.",
      "usage": "abcd intent consistency ingest --findings-json <path> [--findings-json <path>...] [--dry-run] [flags]",
      "flags": [
        {
          "name": "dry-run",
          "type": "bool"
        },
        {
          "name": "findings-json",
          "type": "list"
        },
        {
          "name": "route",
          "type": "list"
        }
      ],
      "inputs": [
        {
          "flag": "findings-json",
          "kind": "json",
          "name": "consistency findings",
          "schema_version": 1,
          "version_in": "schema_version"
        }
      ],
      "example": "abcd intent consistency ingest --findings-json findings.json"
    },
    {
      "path": "abcd intent edge",
      "sentence": "Add or remove an intent's blocked_by and builds_on edges: Writes the two lists in place; refuses an id no intent store holds.",
      "usage": "abcd intent edge <itd-N> [--blocked-by <itd-M,...>] [--unblock <itd-M,...>] [--builds-on <itd-M,...>] [--drop-builds-on <itd-M,...>] [flags]",
      "flags": [
        {
          "name": "blocked-by",
          "type": "string"
        },
        {
          "name": "builds-on",
          "type": "string"
        },
        {
          "name": "drop-builds-on",
          "type": "string"
        },
        {
          "name": "unblock",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd intent edge itd-2609010000000001 --blocked-by itd-2609010000000002"
    },
    {
      "path": "abcd intent hold",
      "sentence": "Hold a draft or planned intent so that planning refuses it: Writes the held line with its reason; refuses without --reason.",
      "usage": "abcd intent hold <itd-N> --reason \"<text>\" [flags]",
      "flags": [
        {
          "name": "reason",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd intent hold itd-2609010000000001 --reason \"waiting on the product thinker's ruling on scope\""
    },
    {
      "path": "abcd intent interview",
      "sentence": "Run an intent's planning interview in a plain Terminal on your own route: Writes the answers record and the role's edits; refuses with no route of yours.",
      "usage": "abcd intent interview <itd-N> [--answers <file>] [--answered-in <place>] [flags]",
      "flags": [
        {
          "name": "answered-in",
          "type": "string",
          "default": "Terminal"
        },
        {
          "name": "answers",
          "type": "string"
        }
      ],
      "inputs": [
        {
          "flag": "answers",
          "kind": "answers",
          "name": "interview answers"
        }
      ],
      "example": "abcd intent interview itd-2609010000000001"
    },
    {
      "path": "abcd intent link",
      "sentence": "Link a planned intent to an existing spec: Writes the intent's spec_id; refuses an intent that is not planned.",
      "usage": "abcd intent link <itd-N> <spc-N> [flags]",
      "flags": [],
      "inputs": [],
      "example": "abcd intent link itd-2609010000000001 spc-2609010000000002"
    },
    {
      "path": "abcd intent plan",
      "sentence": "Plan a draft, or several as a named bundle, or stamp a planned one's conditions: Writes the intents and their spec; refuses a held intent or a bundle's blocker.",
      "usage": "abcd intent plan <itd-N> [<itd-N>…] [--bundle <name>] [--target <vX.Y.Z|next>] [flags]",
      "flags": [
        {
          "name": "bundle",
          "type": "string"
        },
        {
          "name": "impact",
          "type": "string"
        },
        {
          "name": "production-mode",
          "type": "string"
        },
        {
          "name": "target",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd intent plan itd-2609010000000001"
    },
    {
      "path": "abcd intent prepass",
      "sentence": "Print a draft's pre-pass input, or write its planning brief from the host's findings: Writes only the brief; refuses a record not on drafts/.",
      "usage": "abcd intent prepass <itd-N> [--findings-json <path> [--dry-run]] [flags]",
      "flags": [
        {
          "name": "dry-run",
          "type": "bool"
        },
        {
          "name": "findings-json",
          "type": "string"
        }
      ],
      "inputs": [
        {
          "flag": "findings-json",
          "kind": "json",
          "name": "pre-pass findings",
          "schema_version": 1,
          "version_in": "schema_version"
        }
      ],
      "example": "abcd intent prepass itd-2609010000000001 --json"
    },
    {
      "path": "abcd intent ready",
      "sentence": "Report whether an intent is ready to implement, exiting 1 when not: Writes its grounds only with --grounds; refuses malformed grounds.",
      "usage": "abcd intent ready <itd-N> [--grounds \"<pursued|deferred|declined>: <conjecture>\"] [flags]",
      "flags": [
        {
          "name": "grounds",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd intent ready itd-2609010000000001"
    },
    {
      "path": "abcd intent reclassify",
      "sentence": "Change an intent's kind, or retire it as superseded by a named successor: Writes the record and its successor together; refuses a shipped intent's kind change.",
      "usage": "abcd intent reclassify <itd-N> --kind <standalone|bundle-member --bundle <name>|superseded --by <itd-M|adr-N> --reason \"<why>\"> [flags]",
      "flags": [
        {
          "name": "bundle",
          "type": "string"
        },
        {
          "name": "by",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string"
        },
        {
          "name": "reason",
          "type": "string"
        }
      ],
      "inputs": [],
      "example": "abcd intent reclassify itd-2609010000000001 --kind superseded --by itd-2609010000000002 --reason \"absorbed by the later intent\""
    },
    {
      "path": "abcd intent target",
      "sentence": "Name the release a planned intent must land by: Writes its target_release line; refuses a draft, a shipped intent, or a value not vX.Y.Z or next.",
      "usage": "abcd intent target <itd-N> <vX.Y.Z|next> [flags]",
      "flags": [],
      "inputs": [],
      "example": "abcd intent target itd-2609010000000001 v0.11.0"
    },
    {
      "path": "abcd intent unhold",
      "sentence": "Lift an intent's hold: Writes the removal of its held line; refuses a record not held.",
      "usage": "abcd intent unhold <itd-N> [flags]",
      "flags": [],
      "inputs": [],
      "example": "abcd intent unhold itd-2609010000000001"
    }
  ]
}
