{
  "format_version": 3,
  "commands": [
    {
      "path": "abcd land",
      "sentence": "Push a branch whose preflight passed and queue its pull request: Writes a push to origin and arms a merge; refuses the default branch or a dirty tree.",
      "usage": "abcd land [<branch>] [flags]",
      "flags": [
        {
          "name": "approve",
          "type": "bool"
        },
        {
          "name": "no-enqueue",
          "type": "bool"
        },
        {
          "name": "no-push",
          "type": "bool"
        },
        {
          "name": "record-review",
          "type": "list"
        },
        {
          "name": "rests-on",
          "type": "string"
        },
        {
          "name": "review-brief",
          "type": "string"
        },
        {
          "name": "state",
          "type": "bool"
        }
      ],
      "inputs": [],
      "example": "abcd land",
      "next": [
        {
          "command": "abcd landings",
          "when": "to see how the change landed once the queue merges it"
        },
        {
          "command": "abcd reserve <record-id> --release",
          "when": "to release the record's reservation once it merges"
        }
      ]
    }
  ]
}
