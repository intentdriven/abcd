{
  "format_version": 3,
  "commands": [
    {
      "path": "abcd drain",
      "sentence": "Fix the issues needing no decision, one lane at a time, and hand the rest back: Writes its state and user-visible drafts; refuses without the rule's record.",
      "usage": "abcd drain [--drive [--yes] [--until <date>] [--profile <name>] [--no-self-update]] [--dry-run] [--max <n>] [--pace <work-minutes>/<pause-minutes>] [--sub-agents <n>] [--fix-rounds <n>] [--judgement <file>] [--take-over] [--skip <iss-N|path> --reason <why>] [--unskip <iss-N|path>] [flags]",
      "flags": [
        {
          "name": "after-update",
          "type": "string",
          "hidden": true
        },
        {
          "name": "drive",
          "type": "bool"
        },
        {
          "name": "dry-run",
          "type": "bool"
        },
        {
          "name": "fix-rounds",
          "type": "string"
        },
        {
          "name": "judgement",
          "type": "string"
        },
        {
          "name": "max",
          "type": "int"
        },
        {
          "name": "no-self-update",
          "type": "bool"
        },
        {
          "name": "pace",
          "type": "string"
        },
        {
          "name": "profile",
          "type": "string"
        },
        {
          "name": "reason",
          "type": "string"
        },
        {
          "name": "skip",
          "type": "list"
        },
        {
          "name": "sub-agents",
          "type": "string"
        },
        {
          "name": "take-over",
          "type": "bool"
        },
        {
          "name": "unskip",
          "type": "list"
        },
        {
          "name": "until",
          "type": "string"
        },
        {
          "name": "update-refused",
          "type": "list",
          "hidden": true
        },
        {
          "name": "yes",
          "type": "bool"
        }
      ],
      "inputs": [],
      "example": "abcd drain --drive\n  abcd drain --drive --yes --max 3\n  abcd drain --dry-run\n  abcd drain --dry-run --json\n  abcd drain --max 3\n  abcd drain --json\n  abcd drain --judgement .abcd/.work.local/run/drain-judgement.json --json",
      "next": [
        {
          "command": "abcd implement status",
          "when": "to see the drain's lanes"
        },
        {
          "command": "abcd capture list --open",
          "when": "to see the issues handed back"
        }
      ]
    }
  ]
}
