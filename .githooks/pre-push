#!/usr/bin/env bash
# Pre-push gate, run on every clone via the global ~/.githooks dispatcher
# (core.hooksPath). Three jobs, and none runs the preflight:
#
#   1. Local branch protection — a fast local echo of the server-side rulesets
#      (applied and mirrored under .abcd/work/rulesets/), so a bad push fails
#      here before it costs a round-trip. The rulesets are the authority;
#      this layer only covers pushes that go through these hooks. It refuses:
#      a direct push to the protected branch, a deletion of it, and any
#      non-fast-forward (force) push to any branch.
#   2. A passing `make preflight` is REQUIRED for every commit a push would
#      put on the remote for the first time, and this hook checks for its
#      receipt rather than running it. git opens the push's connection BEFORE
#      it runs this hook, so a preflight run here held the connection open for
#      its whole length; one outlasted the transport's idle timeout, the server
#      closed the connection, and the push reported success while moving
#      nothing (iss-2608290810036869). The gate therefore runs first, as its own
#      command: `make preflight` mints a receipt for HEAD when it passes on a
#      tree that matches HEAD (scripts/preflight-receipt.sh), and this hook
#      refuses a push whose new commit carries none, in milliseconds. A commit
#      the remote already holds needs no receipt — a tag on a merged commit, a
#      branch re-pushed at a published tip — because it leaves nothing new.
#
#      The receipt also closes the working-tree gap (iss-2608210738378295): the
#      gates read the working tree, CI reads the commit, and a receipt is minted
#      only when the two were the same for the whole run. A staged rename with
#      its follow-up edit left unstaged passes every gate on the tree and fails
#      CI on the commit; here it earns no receipt, so the push is refused.
#
#      What the preflight runs: the load check first (load-check, a warning,
#      never a failure), then the `make fmt-check` format gate, the six lint
#      gates (lint-reviews, lint-issues, record-lint, issue-drift, docs-lint,
#      check-attribution over the branch's commits), the secrets-check and
#      vulncheck scans (CI's gitleaks and govulncheck, at its pins),
#      the site-render gate and both tagged eval lanes
#      (smoke, evals-cold-reading), then build, vet, test and the race-enabled
#      internal tests, every Go step on the toolchain go.mod declares, as CI's
#      are. The eval lanes are named because the untagged `go test` step cannot
#      compile them, so a defect there would otherwise reach a push unopposed
#      (iss-2608311632382737). The workflow-audit and dependency-review lanes
#      run in Actions only, and the
#      record-lint job there repeats the reviews-charter and issue-resolution
#      gates preflight already ran here.
#
#      The exemptions are the receipt-less prefixes, declared in the table
#      below, one row per prefix, each with the shape check a push under it
#      must pass and the record that rules it. There are two. The first: a reservation
#      (`abcd reserve`, itd-2609091034175565) is a
#      branch under refs/heads/abcd-reserved/ holding a chain of commits whose
#      tree is the empty tree. They change no file, so there is nothing for a
#      preflight to vouch for, and the verb pushes them with this hook running,
#      never with --no-verify. An update under that prefix therefore passes
#      without a receipt, but only when EVERY commit the push moves has the
#      empty tree: the range is <remote>..<local> on an update and everything
#      reachable from <local> on a create, so ordinary history pushed under the
#      prefix walks into a non-empty tree and is gated as any branch is. The
#      exemption sits after the non-fast-forward guard, which still refuses a
#      forced push to a reservation branch. A deletion under the prefix is
#      refused outright: a reservation ends with a tombstone
#      (`abcd reserve <id> --release`), and a deleted tip would let the next
#      reserve take the record with no lease judgement.
#
#      The second: a status branch (`abcd announce`, itd-2609151838312703,
#      adr-2610150729333337), refs/heads/abcd-status/<holder id> (a GitHub
#      username on a branch made before the holder id), one per person,
#      holding that person's announcements as a chain of empty-tree
#      commits. It passes the same reservation_shape check, so it admits
#      nothing the reservation row does not: a fast-forward of commits that
#      change no file. A push under it that changes a file or rewrites the
#      branch is gated as any branch is, and a deletion is refused outright:
#      a status branch is kept for ever.
#
#      This hook runs only where core.hooksPath points at it. abcd's cloud
#      setup script points it here, so a hosted session set up by abcd runs
#      it, from the shallow clone such a session starts with; a session that
#      skips the setup runs no hook at all. Where no hook runs, the server's
#      rulesets (deletion and non-fast-forward refused under both prefixes,
#      mirrored in .abcd/work/rulesets/) and abcd's own reader, which shows a
#      status commit that changes a file as doubtful, are the guards; nothing
#      on the forge refuses a file-changing push to a status branch.
#
#      A cloud session's work-in-progress branch (itd-2610120738075547 C7,
#      adr-2610120937435856, brief invariant 23) is the third exemption, one
#      row per prefix a host connector declares, added to the table when the
#      hook runs. A cloud session cannot earn a receipt where it runs, and no
#      receipt minted there is trusted anyway (the intent's decision 9: every
#      cloud result is re-checked by the person's own collect), so its work
#      goes to <prefix><item-id> without one rather than staying trapped on the
#      hosted machine. The prefixes are read from the declarations under
#      scripts/cloud/connectors/ through scripts/cloud/connector.sh, the one
#      validation every cloud script uses, so the hook names no host. Both are
#      read from the tree HEAD commits, never the working tree, so an
#      uncommitted edit cannot widen the exemption. A declaration that fails
#      the validation adds no row, rather than leave the hook acting on a
#      partial list: a push to a branch holding the segment abcd-wip is then
#      refused, naming the file, and every other push is judged as if no
#      connector existed. A push under a prefix passes
#      without a receipt only when the branch is the prefix and exactly one
#      record id, and every commit it moves passes the attribution gate
#      (scripts/check-attribution.sh): <remote>..<local> on an update, and from
#      the merge base with origin's default branch on a create. Anything else
#      under the prefix is gated as any branch is, and the default-branch and
#      non-fast-forward refusals still come first. A deletion under it is
#      refused: the branch ends by its collect, and a spent one is swept later
#      from an ordinary machine. The hook is not what keeps this work off the
#      default branch; the wip-guard required check and the ruleset are.
#
#      A commit is "already on a remote", and needs no receipt for that, only
#      when a remote-tracking ref outside every receipt-less prefix holds it.
#      A ref under one was pushed without a receipt, so it vouches for nothing:
#      counting it would let a commit pushed to <prefix><id> first reach any
#      other branch with none.
#
#   3. Once the two jobs above pass, a push that fast-forwards the head of an
#      armed or queued pull request of the repository its URL names is refused,
#      naming `abcd land` and the command that withdraws the arming. The hook
#      changes nothing on the forge: it stops and says so.
#
# `git push --no-verify` skips this hook, as it skips every hook; CI re-runs
# every preflight gate on the pushed commit and is the authority on those.
set -euo pipefail
# Every read below sees objects as stored, as the push sends them: a local
# refs/replace/* ref can stand one commit in for another, so a commit carrying
# files could otherwise read as one with the empty tree. A .git/info/grafts
# file is honoured even then, and can give a commit no parents, hiding the
# commits beneath it from the walk, so no graft file is read: GIT_GRAFT_FILE
# names a path that cannot exist, which git reads as no grafts at all. A
# commit-graph file is a cache git reads a commit's tree and parents from in
# place of the commit, and one written by hand can claim the empty tree for a
# commit carrying files, so no commit-graph is read either. core.commitGraph
# is set false as the last entry of GIT_CONFIG_PARAMETERS, where a `git -c`
# given to the push also arrives and the last entry wins, so every git the hook
# and its scripts run reads it, whatever the environment gave; and
# GIT_TEST_COMMIT_GRAPH, which loads a graph whatever the setting says, is off.
export GIT_NO_REPLACE_OBJECTS=1
export GIT_GRAFT_FILE=/dev/null/none
export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }'core.commitgraph'='false'"
export GIT_TEST_COMMIT_GRAPH=0
cd "$(git rev-parse --show-toplevel)"

protected="main"
remote_name="${1:-}"
empty_tree="$(git hash-object -t tree /dev/null)"

# is_null_id succeeds for the null object id git sends for a side that does
# not exist: all zeros, forty of them under SHA-1 and sixty-four under SHA-256,
# so it is read by what it is made of, never by its length.
is_null_id() {
  case "$1" in
  "" | *[!0]*) return 1 ;;
  esac
}

# only_empty_trees succeeds when every commit in the range git rev-list is
# given has the empty tree, and fails when one does not or the range cannot be
# walked (a remote tip this clone does not hold): the push is then gated.
#
# It also fails when the walk could not read the whole range. In a shallow
# clone a .git/shallow line stops the walk at the commit it names, as a graft
# would, and the commits beneath it go unread; the walk lists that commit with
# fewer parents than the commit itself stores. So the check compares, for every
# commit it lists, the parents the walk followed with the parents the commit
# stores, and refuses on any difference: its unread parents may be new commits
# carrying files. git's own walk decides which commits are cut, so however the
# shallow file is written, the hook reads it as git does. A range whose every
# listed commit kept all its parents was read in full, because each parent is
# either listed too or reachable from the remote tip, so already on the
# remote. A hosted session's shallow clone therefore pushes an announcement or
# a reservation over a tip it fetched without a receipt, and the walk only
# reads: nothing is fetched, deepened or written.
only_empty_trees() {
  local listing walked line stored parents oldifs walked_n stored_n
  listing="$(git rev-list --format=%T "$@" 2>/dev/null)" || return 1
  [ -n "$empty_tree" ] || return 1
  [ -z "$(printf '%s\n' "$listing" | grep -v -e '^commit ' -e "^$empty_tree\$" -e '^$')" ] || return 1
  walked="$(git rev-list --parents "$@" 2>/dev/null)" || return 1
  oldifs="$IFS"
  IFS=$'\n'
  for line in $walked; do
    IFS="$oldifs"
    # shellcheck disable=SC2086 # the line is ids separated by spaces
    set -- $line
    walked_n=$(($# - 1))
    stored="$(git cat-file commit "$1" 2>/dev/null)" || return 1
    # The header ends at the first blank line; sed reads to the end rather
    # than quit there, so a long message never cuts the pipe under pipefail.
    parents="$(printf '%s\n' "$stored" | sed -n -e '1,/^$/{' -e '/^parent /p' -e '}')" || return 1
    # shellcheck disable=SC2086 # the lines are "parent <id>" pairs
    set -- $parents
    stored_n=$(($# / 2))
    [ "$walked_n" -eq "$stored_n" ] || return 1
    IFS=$'\n'
  done
  IFS="$oldifs"
}

# reservation_shape is the reservations' shape check: the push is a
# fast-forward (or a create) and every commit it moves has the empty tree. The
# range is everything new on an update, and everything reachable on a create.
# A remote tip this clone does not hold fails both tests, so the push is gated.
# So does a range a shallow clone cannot read in full (only_empty_trees).
reservation_shape() {
  local remote_sha="$1" local_sha="$2"
  if is_null_id "$remote_sha"; then
    only_empty_trees "$local_sha"
  else
    git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null &&
      only_empty_trees "$remote_sha..$local_sha"
  fi
}

# wip_id_re is the one record id a work-in-progress branch carries after its
# prefix: an iss-, itd- or spc- id of sixteen digits, or an ordinal itd- or
# iss- id, and nothing else.
wip_id_re='^((iss|itd|spc)-[0-9]{16}|(iss|itd)-[0-9]{1,4})$'

# wip_shape is the work-in-progress branches' shape check, for the branch the
# loop is on and the row receiptless_row found ($branch, $row_prefix): the
# branch is the prefix and one record id, and every commit the push moves
# passes the attribution gate. The range is <remote>..<local> on an update, a
# fast-forward; on a create it starts at the merge base with origin's default
# branch. A remote tip this clone does not hold, or a default branch it cannot
# name, fails the check, so the push is gated. It says why on a failure, since
# the refusal that follows names only the missing receipt. The attribution
# gate's own findings name the identity it refuses, so they are kept from the
# output: the hook prints a fixed sentence naming every cause the gate refuses
# (the identity half and the message half) and the command that shows which,
# and never an identity itself.
wip_shape() {
  local remote_sha="$1" local_sha="$2" id default base
  id="${branch#"$row_prefix"}"
  if ! [[ "$id" =~ $wip_id_re ]]; then
    echo "pre-push: '$branch' is under $row_prefix but is not that prefix and one record id ($row_ruling);" >&2
    echo "          it is gated as any branch is." >&2
    return 1
  fi
  if is_null_id "$remote_sha"; then
    if ! default="$(bash scripts/cloud/default-branch.sh </dev/null 2>/dev/null)" ||
      ! base="$(git merge-base "refs/remotes/origin/$default" "$local_sha" 2>/dev/null)"; then
      echo "pre-push: cannot find where '$branch' leaves origin's default branch, so its commits cannot be judged;" >&2
      echo "          it is gated as any branch is." >&2
      return 1
    fi
  else
    git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null || return 1
    base="$remote_sha"
  fi
  if ! bash scripts/check-attribution.sh commits "$base" "$local_sha" </dev/null >/dev/null 2>&1; then
    echo "pre-push: the pushed commits fail the attribution gate (a machine author or committer, a missing or malformed Assisted-by trailer, an AI Co-Authored-By trailer, or a tool footer or session URL in a message); run scripts/check-attribution.sh commits $base $local_sha to see which ($row_ruling);" >&2
    echo "          '$branch' is gated as any branch is." >&2
    return 1
  fi
}

# shape_check runs the shape check a row names on <remote_sha> <local_sha>,
# or, given the name alone, succeeds when it is a shape check at all. Each one
# is spelled here by name, so no command ever runs under a name read from the
# table; a name with no arm here is no shape check.
shape_check() {
  case "$1" in
  reservation_shape) [ "$#" -eq 1 ] || reservation_shape "$2" "$3" ;;
  wip_shape) [ "$#" -eq 1 ] || wip_shape "$2" "$3" ;;
  *) return 1 ;;
  esac
}

# The receipt-less prefixes: branches a push may move without a preflight
# receipt, because the shape check proves the push changes no file. One row
# per prefix, its fields separated by "|":
#
#   prefix | shape check | the record that rules it | the act that ends one
#
# The shape check is a function above, given <remote_sha> <local_sha>, that
# succeeds only for a push of the prefix's own shape, with its own arm in
# shape_check. The last field is named
# when a delete under the prefix is refused, with <name> standing for the
# branch's name after the prefix, or is "never" for a branch kept for ever: a
# ref under a receipt-less prefix is never deleted by a push.
#
# A new row needs its own ruling record and its own shape check. A prefix with
# no shape check, or one naming a check shape_check has no arm for, is never
# receipt-less: its pushes are gated as any branch is. Cloud sessions'
# work-in-progress rows, ruled by adr-2610120937435856, are not written here:
# their prefixes belong to the host connectors, so the block after
# receiptless_row appends one row per declared prefix when the hook runs, each
# with the wip_shape check.
receiptless_prefixes=(
  "abcd-reserved/|reservation_shape|adr-2610031352212697|abcd reserve <name> --release"
  "abcd-status/|reservation_shape|adr-2610150729333337|never"
)

# receiptless_row finds the row whose prefix the branch is under and whose
# shape check is defined, setting row_prefix, row_shape, row_ruling and
# row_end; it fails when there is none.
receiptless_row() {
  local row
  for row in "${receiptless_prefixes[@]}"; do
    IFS='|' read -r row_prefix row_shape row_ruling row_end <<<"$row"
    [ -n "$row_prefix" ] && [ -n "$row_shape" ] || continue
    shape_check "$row_shape" || continue
    case "$1" in
    "$row_prefix"*) return 0 ;;
    esac
  done
  return 1
}

# The work-in-progress rows: one per prefix the host connectors declare, read
# through scripts/cloud/connector.sh and never parsed here, so every rule of a
# declaration (the prefix ends in the segment abcd-wip/ with at most one
# segment before it, no two connectors share one) is that script's alone.
#
# Both the loader and the declarations are read from the tree HEAD commits,
# extracted to a temporary directory, never from the working tree: an
# uncommitted or untracked edit there cannot widen the exemption. A checkout
# whose HEAD carries no loader declares no prefix, and its pushes are gated as
# before.
#
# A declaration the loader refuses (a stray directory, a lost exec bit, a bad
# key or prefix) adds no row at all, rather than leave the hook acting on a
# partial list, and its diagnostic is printed, naming the file. It costs only
# the work-in-progress exemption: a push to a branch holding the segment
# abcd-wip, in any case, is refused naming the declaration until it is fixed,
# and every other push is judged as if no connector existed, so a reservation
# or a branch with its receipt still goes ahead. Each row ends by the person's
# collect of the item; the spent branch is swept later from an ordinary
# machine, never deleted by a push through this hook.
wip_bad=""
if git cat-file -e HEAD:scripts/cloud/connector.sh 2>/dev/null; then
  decl_dir="$(mktemp -d "${TMPDIR:-/tmp}/abcd-pre-push.XXXXXX")"
  trap '/bin/rm -rf -- "$decl_dir"' EXIT
  wip_prefixes=""
  # The archive goes to a file and tar reads the file, never a pipe between
  # them: a tar that stops at the end-of-archive marker leaves git archive
  # writing the rest of its last record into a closed pipe, and under
  # pipefail that read failed now and then on a loaded runner, refusing every
  # work-in-progress push it judged. What either command says is kept, so a
  # read that fails names its cause.
  if ! git archive --format=tar -o "$decl_dir/cloud.tar" HEAD -- scripts/cloud 2>"$decl_dir/read-error" ||
    ! tar -x -C "$decl_dir" -f "$decl_dir/cloud.tar" 2>>"$decl_dir/read-error" ||
    [ ! -f "$decl_dir/scripts/cloud/connector.sh" ] || [ -L "$decl_dir/scripts/cloud/connector.sh" ]; then
    read_error="$(tr '\n' ' ' <"$decl_dir/read-error" 2>/dev/null | cut -c1-300 || true)"
    wip_bad="pre-push: the connector loader and declarations HEAD commits under scripts/cloud/ could not be read${read_error:+ (${read_error% })}."
  elif ! wip_prefixes="$(bash "$decl_dir/scripts/cloud/connector.sh" prefixes </dev/null 2>"$decl_dir/diagnostic")"; then
    wip_bad="$(cat "$decl_dir/diagnostic")"
    [ -n "$wip_bad" ] || wip_bad="pre-push: the connector loader refused the declarations under scripts/cloud/connectors/."
    wip_prefixes=""
  fi
  if [ -n "$wip_bad" ]; then
    printf '%s\n' "$wip_bad" >&2
    echo "pre-push: a host connector declaration under scripts/cloud/connectors/ fails its validation (scripts/cloud/connector.sh validate names it, as committed at HEAD (commit or discard local edits to compare))." >&2
    echo "          No work-in-progress prefix is exempt from the receipt, and a push to a branch holding the" >&2
    echo "          segment abcd-wip is refused until it is fixed (adr-2610120937435856). Every other push is judged as usual." >&2
  fi
  while IFS= read -r wip_prefix; do
    [ -n "$wip_prefix" ] || continue
    receiptless_prefixes+=("$wip_prefix|wip_shape|adr-2610120937435856|scripts/cloud/collect.sh <name>")
  done <<<"$wip_prefixes"
fi

# lower prints its argument in lower case (bash 3.2 has no ${x,,}).
lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# receiptless_tracking succeeds when a remote-tracking ref, given without its
# refs/remotes/ part (<remote>/<branch>), is under a receipt-less prefix: any
# row of the table, or any branch holding the segment abcd-wip whatever the
# declarations say. Such a ref was pushed without a receipt, so it vouches for
# nothing. The match is by segment anywhere after the remote's name, and in
# any case, so it errs towards asking for a receipt, never away from it.
receiptless_tracking() {
  local tracked row prefix
  tracked="/$(lower "$1")/"
  case "$tracked" in
  */abcd-wip/*) return 0 ;;
  esac
  for row in "${receiptless_prefixes[@]}"; do
    prefix="$(lower "${row%%|*}")"
    [ -n "$prefix" ] || continue
    case "$tracked" in
    */"$prefix"*) return 0 ;;
    esac
  done
  return 1
}

# on_a_remote succeeds when a remote-tracking ref outside every receipt-less
# prefix already holds the commit. A ref under one does not count: a push
# there needs no receipt, so counting it would let a commit pushed there first
# reach any other branch with none (push X to <prefix><id>, then X to feat/x).
on_a_remote() {
  local ref
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    receiptless_tracking "${ref#refs/remotes/}" && continue
    return 0
  done < <(git for-each-ref --format='%(refname)' --contains "$1" refs/remotes 2>/dev/null)
  return 1
}

missing=""
moves=""
while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"

  if [ "$branch" = "$protected" ]; then
    if is_null_id "$local_sha"; then
      echo "pre-push: refusing to delete protected branch '$protected'." >&2
    else
      echo "pre-push: refusing direct push to protected branch '$protected' — open a PR." >&2
    fi
    exit 1
  fi

  # Under a declaration that fails validation, a branch holding the segment
  # abcd-wip is refused outright, whatever it carries: no row exempts it, and
  # a receipt is no answer to a declaration that cannot be read.
  if [ -n "$wip_bad" ]; then
    case "/$(lower "$branch")/" in
    */abcd-wip/*)
      printf '%s\n' "$wip_bad" >&2
      echo "pre-push: refusing the push to '$branch': it holds the segment abcd-wip, and a host connector declaration fails its validation (scripts/cloud/connector.sh validate names it, as committed at HEAD (commit or discard local edits to compare))." >&2
      echo "          Fix the declaration first (adr-2610120937435856)." >&2
      exit 1
      ;;
    esac
  fi

  # A deletion carries no commit to gate, except under a receipt-less prefix:
  # a ref there ends by the push its row names, never a deletion. For a
  # reservation that is a tombstone, because a deleted tip reads as absent and
  # the next reserve takes the record with no lease judgement at all.
  if is_null_id "$local_sha"; then
    if receiptless_row "$branch"; then
      if [ "$row_end" = "never" ]; then
        echo "pre-push: refusing to delete '$branch': a branch under $row_prefix is kept for ever and never deleted ($row_ruling)." >&2
        exit 1
      fi
      echo "pre-push: refusing to delete '$branch': a branch under $row_prefix ends by a push, never a deletion ($row_ruling);" >&2
      echo "          end it with \`${row_end//<name>/${branch#"$row_prefix"}}\`." >&2
      exit 1
    fi
    continue
  fi

  # Non-fast-forward (force) push guard on an existing remote branch.
  if ! is_null_id "$remote_sha"; then
    if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      : # fast-forward — fine
    else
      rc=$?
      # rc==1: definitively not an ancestor -> a force push. rc>1: the remote
      # object is not present locally / indeterminate -> don't false-block.
      if [ "$rc" -eq 1 ]; then
        echo "pre-push: refusing non-fast-forward (force) push to '$branch'." >&2
        exit 1
      fi
    fi
  fi

  # A receipt-less prefix: a push of its row's shape needs no receipt. Any
  # other push under it is gated as any branch is.
  if receiptless_row "$branch" && shape_check "$row_shape" "$remote_sha" "$local_sha"; then
    continue
  fi

  # The commit the ref will point at: a tag is peeled to the commit it names.
  commit="$(git rev-parse --verify --quiet "$local_sha^{commit}" 2>/dev/null || true)"
  [ -n "$commit" ] || continue

  # A branch this push fast-forwards from a tip this clone holds, for the arming
  # check once the gates have passed.
  case "$remote_ref" in
  refs/heads/*)
    if ! is_null_id "$remote_sha" && [ "$remote_sha" != "$commit" ] &&
      git merge-base --is-ancestor "$remote_sha" "$commit" 2>/dev/null; then
      moves="$moves$branch $commit"$'\n'
    fi
    ;;
  esac

  # Already on a remote: pushing it moves no new commit off this machine. Only
  # a ref outside every receipt-less prefix counts (on_a_remote).
  if on_a_remote "$commit"; then
    continue
  fi

  if ! scripts/preflight-receipt.sh check "$commit"; then
    missing="$missing $commit:$local_ref"
  fi
done

if [ -n "$missing" ]; then
  for entry in $missing; do
    echo "pre-push: BLOCKED — no passing preflight for ${entry%%:*} (${entry#*:})." >&2
  done
  echo "          the gate runs BEFORE the push opens its connection, never inside it: run" >&2
  echo "          \`make preflight\` with that commit checked out and nothing uncommitted beside it" >&2
  echo "          (staged, unstaged and untracked changes all withhold the receipt), then push" >&2
  echo "          again${remote_name:+ to $remote_name}." >&2
  exit 1
fi

# bounded runs a forge call under a time limit: git holds the push's connection
# open while this hook runs, and a stalled call must not outlast it.
bounded() {
  local pid dog rc=0
  GH_PROMPT_DISABLED=1 "$@" </dev/null &
  pid=$!
  (
    sleep 20
    kill "$pid" 2>/dev/null
  ) >/dev/null 2>&1 &
  dog=$!
  wait "$pid" || rc=$?
  kill "$dog" 2>/dev/null || true
  wait "$dog" 2>/dev/null || true
  return "$rc"
}

# The question the landing asks (landing.ArmingsQuery).
arming_query='query($o:String!,$r:String!,$b:String!){viewer{login} repository(owner:$o,name:$r){pullRequests(states:OPEN,headRefName:$b,first:100){pageInfo{hasNextPage} nodes{number id headRefOid isCrossRepository isInMergeQueue mergeQueueEntry{enqueuer{login}} autoMergeRequest{mergeMethod enabledBy{login}}}}}}'
arming_nodes='.data.repository.pullRequests | (if .pageInfo.hasNextPage then "more" else empty end), (.nodes[] | select((.isCrossRepository | not) and (.isInMergeQueue or .autoMergeRequest != null)) | [.number, .headRefOid, .isInMergeQueue] | @tsv)'

# github_repo_of prints the owner/name this push's URL names, which git hands the
# hook, and fails unless it reaches github.com, by its own host or an ssh alias
# that resolves to it.
github_repo_of() {
  local url="${1%/}" host path rest real
  url="${url%.git}"
  case "$url" in
  *://*)
    rest="${url#*://}"
    rest="${rest##*@}"
    host="${rest%%/*}"
    host="${host%%:*}"
    path="${rest#*/}"
    ;;
  /* | ./* | ../*) return 1 ;;
  *:*)
    host="${url%%:*}"
    host="${host##*@}"
    path="${url#*:}"
    path="${path#/}"
    ;;
  *) return 1 ;;
  esac
  host="$(lower "$host")"
  case "$host" in
  "" | -*) return 1 ;;
  esac
  if [ "$host" != "github.com" ] && [ "$host" != "ssh.github.com" ]; then
    command -v ssh >/dev/null 2>&1 || return 1
    real="$(ssh -G "$host" 2>/dev/null | sed -n '/^hostname /{s///p;q;}' || true)"
    real="$(lower "$real")"
    [ "$real" = "github.com" ] || [ "$real" = "ssh.github.com" ] || return 1
  fi
  case "$path" in
  *[!A-Za-z0-9_./-]* | */*/* | /* | */) return 1 ;;
  */*) printf '%s' "$path" ;;
  *) return 1 ;;
  esac
}

if [ -n "$moves" ]; then
  if ! forge_repo="$(github_repo_of "${2:-}")"; then
    echo "pre-push: the arming check reads repositories on github.com, so it does not apply to this push." >&2
  elif ! command -v gh >/dev/null 2>&1; then
    echo "pre-push: gh is not installed, so this push's branches were not read for an arming." >&2
  else
    while read -r branch commit; do
      [ -n "$branch" ] || continue
      if ! armed="$(bounded gh api graphql --hostname github.com -f query="$arming_query" -f o="${forge_repo%%/*}" -f r="${forge_repo#*/}" -f b="$branch" --jq "$arming_nodes")"; then
        echo "pre-push: gh gave no answer on whether a pull request for '$branch' is armed." >&2
        continue
      fi
      while IFS=$'\t' read -r n head queued; do
        if [ "$n" = "more" ]; then
          echo "pre-push: read the first 100 open pull requests from a branch named '$branch'." >&2
          continue
        fi
        [ -n "$n" ] && [ "$head" != "$commit" ] || continue
        echo "pre-push: refusing the push to '$branch': pull request #$n is armed at ${head:0:12}, and this push moves its head to ${commit:0:12}." >&2
        echo "          Land it with \`abcd land\`, which withdraws the arming and arms a head the merge gate arms, or withdraw it yourself, then push again:" >&2
        if [ "$queued" = "true" ]; then
          echo "          take it out of the merge queue on its page, and turn its auto-merge off (gh pr merge $n --disable-auto --repo $forge_repo) if it is on." >&2
        else
          echo "          gh pr merge $n --disable-auto --repo $forge_repo" >&2
        fi
        exit 1
      done <<<"$armed"
    done <<<"$moves"
  fi
fi
