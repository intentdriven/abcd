#!/usr/bin/env bash
# abcd-name-guard: v1
# Local name guard, merge-commit half — run on every clone via the global
# ~/.githooks dispatcher, beside the committed pre-commit hook. It is the same
# artefact `abcd ahoy` scaffolds into a managed repo.
#
# git does NOT run pre-commit for a merge commit. Without this file every name the
# private layer bans walks into history the moment a merge COMMIT carrying it is made,
# and the guard reports nothing, because it was never asked. The same check runs
# here, on the same staged content, with the same output contract: a match refuses
# the merge naming the entry KEY alone.
#
# Neither hook covers everything, and the list is explicitly non-exhaustive: a
# fast-forward `git pull` creates no commit at all, and `git rebase`, `git am`,
# `git revert`, `git cherry-pick` (when it does not stop for an edit),
# `git commit --no-verify` and a server-side push bypass both by construction. This
# layer covers the commits git asks a hook about, on machines that have opted in —
# nothing more, and the reach every abcd surface states says exactly that.
set -euo pipefail
# --- environment pin: the FIRST statements, matching the guard this delegates to ---
# Without them this half is the soft way in: it would exec the delegate under an
# inherited PATH, IFS and xtrace, which is precisely the substitution the pre-commit
# half pins against. `#!/usr/bin/env bash` on line 1 still resolves the interpreter
# through the inherited PATH, so the class is narrowed rather than closed.
case $- in *x*) set +x ;; esac
# Drop any inherited shell FUNCTION shadowing a command this hook runs. Pinning PATH
# does nothing against `BASH_FUNC_grep%%=() { return 1; }` in the environment: a
# function wins over PATH lookup, so the guard would report a clean check for ever
# while announcing its entry count. Same class as the PATH prepend, different route.
# `read`, `echo`, `exit`, `test` and `[` are pinned for the delegate's sake, and
# every surviving function is swept after the fixed list — see the pre-commit
# half for why, including why the fixed list must carry `exit`.
unset -f git grep mktemp tr cat mkdir rm chmod printf sed head command read echo exit test [ 2>/dev/null || true
IFS=$' \t\n'
set -f
for _fn in $(declare -F); do
  case "$_fn" in declare|-f|-fx) continue ;; esac
  unset -f "$_fn" 2>/dev/null || true
done
set +f
unset _fn 2>/dev/null || true
LC_ALL=C
export LC_ALL
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
# --- end environment pin ----------------------------------------------------------

# The sibling pre-commit hook holds the whole guard: one implementation, so the two
# entry points cannot drift into checking different things. $0 is the path git
# invoked, so this resolves inside whichever hooks directory the clone points at
# (.githooks under `core.hooksPath`, or .git/hooks for a copied install).
#
# Pure parameter expansion, never `dirname`: an external command here would be the
# first thing this hook runs, and resolving it through PATH is the substitution the
# pin above exists to prevent. `${0%/*}` is the same answer for every path git
# actually invokes a hook by (always at least one slash).
guard="${0%/*}/pre-commit"
if [ ! -x "$guard" ]; then
  echo "pre-merge-commit: BLOCKED — the name guard at $guard is missing or not executable." >&2
  echo "                  a merge is exactly the commit that bypasses pre-commit, so this refuses" >&2
  echo "                  rather than let it through unchecked. Restore .githooks/pre-commit." >&2
  exit 1
fi
exec "$guard" "$@"
