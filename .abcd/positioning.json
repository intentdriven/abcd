{
  "schema_version": 1,
  "block": {
    "file": ".abcd/development/brief/01-product/README.md",
    "heading": "Identity (canonical)"
  },
  "severity": "warn",
  "surfaces": [
    {
      "id": "readme-strapline",
      "files": ["README.md"],
      "kind": "regexp",
      "patterns": ["(?s)<p>(.*?)</p>"],
      "requires": ["name", "descriptor", "tagline", "purpose"],
      "template": "{name} — {descriptor}. {tagline} {purpose}"
    },
    {
      "id": "manifest-description",
      "files": [".claude-plugin/plugin.json"],
      "kind": "json_field",
      "field": "description",
      "requires": ["listing"],
      "template": "{listing}"
    },
    {
      "id": "catalogue-description",
      "files": [".claude-plugin/marketplace.json"],
      "kind": "regexp",
      "patterns": ["(?s)\"plugins\"\\s*:\\s*\\[\\s*\\{.*?\"description\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\""],
      "requires": ["listing"],
      "template": "{listing}"
    },
    {
      "id": "conventions-opening",
      "files": ["AGENTS.md"],
      "kind": "regexp",
      "patterns": ["(?s)<!-- END ABCD -->\\n+(.*?)(?:\\n\\n|\\z)"],
      "requires": ["name", "title", "descriptor"],
      "template": "{name} ({title}) is {descriptor}."
    },
    {
      "id": "banner-baked-identity",
      "files": ["internal/surface/cli/identity_gen.go"],
      "kind": "regexp",
      "patterns": ["bakedTagline = \"(.*?)\""],
      "requires": ["tagline"],
      "template": "{tagline}"
    },
    {
      "id": "citation-abstract",
      "files": ["CITATION.cff"],
      "kind": "regexp",
      "patterns": ["(?m)^abstract: \"(.*)\"$"],
      "requires": ["title", "descriptor"],
      "template": "{title}: {descriptor}"
    }
  ]
}
