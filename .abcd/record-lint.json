      "severity": "blocker",
      "runbook": ".abcd/development/release-gate/README.md",
      "workflow": ".github/workflows/release.yml",
      "job": "verify",
      "ignore_steps": [
        "Check out the pushed commit",
        "Set up Go",
        "Semantic-gate receipts (fail-closed, before tag)"
      ],
      "min_gates": 9
    },
    "forbidden_synonyms": {
      "enabled": true,
      "severity": "blocker",
      "glossary_dir": ".abcd/development/brief/glossary",
      "enforce": [
        "epic"
      ],
      "exempt_prefixes": [
        ".abcd/development/research/",
        ".abcd/development/decisions/",
        ".abcd/development/plans/",
        ".abcd/development/intents/shipped/",
        ".abcd/development/intents/superseded/",
        ".abcd/development/releases/"
      ],
      "allow_context": [
        "epic-review",
        "epic->spec",
        "epic\u2192spec",
        "epic-to-spec"
      ]
    },
    "glossary_family_pointer": {
      "enabled": true,
      "severity": "blocker",
      "glossary_dir": ".abcd/development/brief/glossary",
      "registry": ".abcd/development/brief/glossary/core/record-families.md"
    },
    "record_family_key": {
      "enabled": true,
      "severity": "warn",
      "glossary_dir": ".abcd/development/brief/glossary",
      "registry": ".abcd/development/brief/glossary/core/record-families.md",
      "record_stores": {
        "adr": ".abcd/development/decisions/adrs",
        "itd": ".abcd/development/intents",
        "spc": ".abcd/development/specs",
        "iss": ".abcd/work/issues",
        "rdi": ".abcd/work/issues/readings",
        "dsp": ".abcd/work/issues/dispositions",
        "rdg": ".abcd/development/readings",
        "adm": ".abcd/work/issues/admissions",
        "srp": ".abcd/work/issues/surprises"
      }
    }
  },
  "exempt_paths": [
    ".abcd/development/research/",
    ".abcd/development/intents/superseded/"
  ],
  "exempt_if_status": [
    "superseded"
  ]
}
